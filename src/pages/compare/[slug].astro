---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import GeoAffiliateLink from "@components/GeoAffiliateLink.astro";
import { getAllProducts, getProductPrices } from "@lib/db";
import { getLowestPrice } from "@lib/pricing";
import type { Product, Price } from "@lib/db";

const { DB, tenant, hostname } = Astro.locals;
const { slug } = Astro.params;
const db = DB!;

const parts = slug?.split("-vs-") || [];
if (parts.length !== 2) {
  return Astro.redirect("/404");
}

const [slugA, slugB] = parts;

const allProducts = await getAllProducts(db, tenant.id);
const productA = allProducts.find((p) => p.slug === slugA);
const productB = allProducts.find((p) => p.slug === slugB);

if (!productA || !productB) {
  return Astro.redirect("/404");
}

const pricesA = await getProductPrices(db, productA.id);
const pricesB = await getProductPrices(db, productB.id);
const bestPriceA = getLowestPrice(pricesA);
const bestPriceB = getLowestPrice(pricesB);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${productA.name} vs ${productB.name}`,
  description: `Compare ${productA.name} and ${productB.name} side by side. Specs, performance, and value analysis.`,
  brand: {
    "@type": "Brand",
    name: `${productA.brand_name} vs ${productB.brand_name}`,
  },
};

const faqItems = [
  {
    question: `Which is better, ${productA.name} or ${productB.name}?`,
    answer: productA.overall_score > productB.overall_score
      ? `The ${productA.name} scores ${productA.overall_score.toFixed(1)}/10 compared to ${productB.overall_score.toFixed(1)}/10 for the ${productB.name}. Our expert analysis favors the ${productA.name} for its superior ${productA.read_speed_mbps > productB.read_speed_mbps ? "speed" : "value"}.`
      : productB.overall_score > productA.overall_score
        ? `The ${productB.name} scores ${productB.overall_score.toFixed(1)}/10 compared to ${productA.overall_score.toFixed(1)}/10 for the ${productA.name}. Our expert analysis favors the ${productB.name} for its superior ${productB.read_speed_mbps > productA.read_speed_mbps ? "speed" : "value"}.`
        : `Both drives score ${productA.overall_score.toFixed(1)}/10 in our expert testing. The best choice depends on your specific needs.`,
  },
  {
    question: `What's the difference between ${productA.name} and ${productB.name}?`,
    answer: `The key differences: The ${productA.name} offers ${productA.read_speed_mbps.toLocaleString()} MB/s reads vs ${productB.read_speed_mbps.toLocaleString()} MB/s for the ${productB.name}. Capacity options differ: ${productA.name} is ${productA.capacity_gb >= 1000 ? `${(productA.capacity_gb / 1000).toFixed(0)}TB` : `${productA.capacity_gb}GB`} while ${productB.name} is ${productB.capacity_gb >= 1000 ? `${(productB.capacity_gb / 1000).toFixed(0)}TB` : `${productB.capacity_gb}GB`}. The ${productA.name} uses ${productA.interface} while the ${productB.name} uses ${productB.interface}.`,
  },
  {
    question: `Which is faster, ${productA.name} or ${productB.name}?`,
    answer: productA.read_speed_mbps > productB.read_speed_mbps
      ? `The ${productA.name} is faster with ${productA.read_speed_mbps.toLocaleString()} MB/s read speeds compared to ${productB.read_speed_mbps.toLocaleString()} MB/s for the ${productB.name}. That's a ${Math.round(((productA.read_speed_mbps - productB.read_speed_mbps) / productB.read_speed_mbps) * 100)}% speed advantage.`
      : productB.read_speed_mbps > productA.read_speed_mbps
        ? `The ${productB.name} is faster with ${productB.read_speed_mbps.toLocaleString()} MB/s read speeds compared to ${productA.read_speed_mbps.toLocaleString()} MB/s for the ${productA.name}. That's a ${Math.round(((productB.read_speed_mbps - productA.read_speed_mbps) / productA.read_speed_mbps) * 100)}% speed advantage.`
        : `Both drives offer the same ${productA.read_speed_mbps.toLocaleString()} MB/s read speeds.`,
  },
  {
    question: `Which has better value, ${productA.name} or ${productB.name}?`,
    answer: bestPriceA && bestPriceB
      ? bestPriceA.price_cents < bestPriceB.price_cents
        ? `The ${productA.name} offers better value — check current pricing at our linked retailers to compare the latest prices.`
        : bestPriceB.price_cents < bestPriceA.price_cents
          ? `The ${productB.name} offers better value — check current pricing at our linked retailers to compare the latest prices.`
          : `Both drives are similarly priced. Consider features and performance to determine value.`
      : "Check current prices at our linked retailers for the latest value comparison.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

function fmtSpeed(mbps: number): string {
  return mbps >= 1000 ? `${(mbps / 1000).toFixed(1)} GB/s` : `${mbps} MB/s`;
}

function fmtCapacity(gb: number): string {
  return gb >= 1000 ? `${(gb / 1000).toFixed(0)} TB` : `${gb} GB`;
}

function getSpecComparison() {
  const specs = [
    { label: "Read Speed", a: fmtSpeed(productA.read_speed_mbps), b: fmtSpeed(productB.read_speed_mbps), winner: productA.read_speed_mbps > productB.read_speed_mbps ? "a" : productB.read_speed_mbps > productA.read_speed_mbps ? "b" : "tie" },
    { label: "Write Speed", a: fmtSpeed(productA.write_speed_mbps), b: fmtSpeed(productB.write_speed_mbps), winner: productA.write_speed_mbps > productB.write_speed_mbps ? "a" : productB.write_speed_mbps > productA.write_speed_mbps ? "b" : "tie" },
    { label: "Capacity", a: fmtCapacity(productA.capacity_gb), b: fmtCapacity(productB.capacity_gb), winner: productA.capacity_gb > productB.capacity_gb ? "a" : productB.capacity_gb > productA.capacity_gb ? "b" : "tie" },
    { label: "Interface", a: productA.interface, b: productB.interface, winner: "tie" },
    { label: "Endurance (TBW)", a: `${productA.tbw.toLocaleString()} TB`, b: `${productB.tbw.toLocaleString()} TB`, winner: productA.tbw > productB.tbw ? "a" : productB.tbw > productA.tbw ? "b" : "tie" },
    { label: "Warranty", a: `${productA.warranty_years} Years`, b: `${productB.warranty_years} Years`, winner: productA.warranty_years > productB.warranty_years ? "a" : productB.warranty_years > productA.warranty_years ? "b" : "tie" },
    { label: "Score", a: `${productA.overall_score.toFixed(1)}/10`, b: `${productB.overall_score.toFixed(1)}/10`, winner: productA.overall_score > productB.overall_score ? "a" : productB.overall_score > productA.overall_score ? "b" : "tie" },
  ];
  return specs;
}

const specs = getSpecComparison();
const aWins = specs.filter((s) => s.winner === "a").length;
const bWins = specs.filter((s) => s.winner === "b").length;

const winner = productA.overall_score > productB.overall_score
  ? productA
  : productB.overall_score > productA.overall_score
    ? productB
    : null;
const loser = winner?.id === productA.id ? productB : productA;
---

<BaseLayout
  title={`${productA.name} vs ${productB.name} - Expert Comparison & Review`}
  description={`Compare ${productA.name} and ${productB.name} side by side. Speed, capacity, price, and value analysis to help you choose the best external SSD.`}
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Compare", href: "/compare" }, { label: `${productA.name} vs ${productB.name}` }]} />

    <div class="mb-6">
      <p class="text-xs text-surface-700 italic leading-relaxed">
        As an Amazon Associate I earn from qualifying purchases. We may earn a commission from qualifying purchases made through links on this page. Prices and availability are subject to change. We are reader-supported and independent — our rankings are based on an objective scoring rubric, not sponsorship.
      </p>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900">
        {productA.name} vs {productB.name}
      </h1>
      <p class="mt-3 text-surface-700 max-w-3xl leading-relaxed">
        Compare {productA.name} and {productB.name} side by side. Both are {productA.capacity_gb >= 1000 ? `${(productA.capacity_gb / 1000).toFixed(0)}TB` : `${productA.capacity_gb}GB`} {productA.interface} external SSDs, but they differ in speed, design, and value. Here's how they stack up.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-8">
      {[productA, productB].map((product, index) => {
        const prices = index === 0 ? pricesA : pricesB;
        const bestPrice = index === 0 ? bestPriceA : bestPriceB;
        const pros = product.pros ? JSON.parse(product.pros) : [];
        const cons = product.cons ? JSON.parse(product.cons) : [];
        const isWinner = winner?.id === product.id;
        return (
          <div class={`rounded-xl border p-6 ${isWinner ? "border-amber-300 bg-amber-50/50" : "border-surface-300"}`}>
            <div class="flex items-center gap-2 mb-3">
              {isWinner && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                  <svg aria-hidden="true" class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  Our Pick
                </span>
              )}
              <p class="text-sm font-medium text-surface-700 uppercase tracking-wider">{product.brand_name}</p>
            </div>
            <a href={`/products/${product.slug}`} class="text-xl font-bold text-surface-900 hover:text-blue-800 no-underline block mb-2">
              {product.name}
            </a>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-sm font-medium text-surface-900">{product.overall_score.toFixed(1)}/10</span>
              <div class="w-20 h-2 bg-surface-100 rounded-full overflow-hidden">
                <div class="h-full bg-blue-600 rounded-full" style={{ width: `${product.overall_score * 10}%` }}></div>
              </div>
            </div>
            <p class="text-sm text-surface-700 mb-4">{product.description}</p>

            <div class="space-y-2 mb-4">
              {pros.slice(0, 3).map((pro: string) => (
                <div class="flex items-start gap-2 text-sm text-emerald-800">
                  <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  {pro}
                </div>
              ))}
            </div>

            {bestPrice && (
              <div class="flex items-center justify-between pt-4 border-t border-surface-200">
                <div>
                  <p class="text-lg font-semibold text-blue-800">See Price</p>
                  <p class="text-xs text-surface-700">at {bestPrice.retailer}</p>
                </div>
                <GeoAffiliateLink
                  url={bestPrice.affiliate_url || "#"}
                  retailer={bestPrice.retailer}
                  label="Check Price →"
                  className="text-sm font-semibold"
                />
              </div>
            )}
          </div>
        );
      })}
    </div>

    <section class="mb-8">
      <h2 class="text-xl font-semibold text-surface-900 mb-4">Spec Comparison</h2>
      <div class="rounded-xl border border-surface-300 overflow-hidden">
        <div class="grid grid-cols-3 bg-surface-50 border-b border-surface-300">
          <div class="px-4 py-3 text-sm font-semibold text-surface-900">Spec</div>
          <div class="px-4 py-3 text-sm font-semibold text-surface-900 text-center">{productA.name}</div>
          <div class="px-4 py-3 text-sm font-semibold text-surface-900 text-center">{productB.name}</div>
        </div>
        {specs.map((spec, i) => (
          <div class={`grid grid-cols-3 border-b border-surface-200 ${i % 2 === 0 ? "bg-white" : "bg-surface-50/50"}`}>
            <div class="px-4 py-3 text-sm font-medium text-surface-900">{spec.label}</div>
            <div class={`px-4 py-3 text-sm text-center ${spec.winner === "a" ? "font-bold text-emerald-800" : "text-surface-700"}`}>
              {spec.a}
              {spec.winner === "a" && <span class="ml-1 text-xs">✓</span>}
            </div>
            <div class={`px-4 py-3 text-sm text-center ${spec.winner === "b" ? "font-bold text-emerald-800" : "text-surface-700"}`}>
              {spec.b}
              {spec.winner === "b" && <span class="ml-1 text-xs">✓</span>}
            </div>
          </div>
        ))}
        <div class="grid grid-cols-3 bg-surface-50">
          <div class="px-4 py-3 text-sm font-semibold text-surface-900">Total Wins</div>
          <div class={`px-4 py-3 text-sm font-bold text-center ${aWins > bWins ? "text-emerald-800" : "text-surface-700"}`}>
            {aWins} {aWins === 1 ? "win" : "wins"}
          </div>
          <div class={`px-4 py-3 text-sm font-bold text-center ${bWins > aWins ? "text-emerald-800" : "text-surface-700"}`}>
            {bWins} {bWins === 1 ? "win" : "wins"}
          </div>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-semibold text-surface-900 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqItems.map((faq) => (
          <details class="group rounded-xl border border-surface-300 overflow-hidden">
            <summary class="flex items-center justify-between px-5 py-4 text-sm font-semibold text-surface-900 cursor-pointer list-none hover:bg-surface-50 transition-colors">
              {faq.question}
              <svg aria-hidden="true" class="w-4 h-4 text-surface-700 shrink-0 ml-2 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-surface-700 leading-relaxed border-t border-surface-200 pt-3">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-semibold text-surface-900 mb-4">More Comparisons</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {allProducts
          .filter((p) => p.id !== productA.id && p.id !== productB.id)
          .slice(0, 4)
          .map((product) => (
            <div class="rounded-xl border border-surface-300 p-4 hover:border-surface-400 transition-colors">
              <a href={`/compare/${productA.slug}-vs-${product.slug}`} class="text-sm font-medium text-blue-800 hover:text-blue-900 no-underline">
                {productA.name} vs {product.name} →
              </a>
              <a href={`/compare/${productB.slug}-vs-${product.slug}`} class="block text-sm font-medium text-blue-800 hover:text-blue-900 no-underline mt-1">
                {productB.name} vs {product.name} →
              </a>
            </div>
          ))}
      </div>
    </section>
  </div>
</BaseLayout>