---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/HeroSection.astro";
import ProductGrid from "@components/ProductGrid.astro";
import AffiliateDisclosure from "@components/AffiliateDisclosure.astro";
import { getTopRatedProducts, getAllProducts, getCategoriesBySite, getLastUpdatedDate, getHubsBySite, getProductBySlug } from "@lib/db";
import type { Product, Hub } from "@lib/db";

const { DB, tenant } = Astro.locals;
const db = DB!;
const [topRated, allProducts, categories, lastUpdated, hubs] = await Promise.all([
  getTopRatedProducts(db, tenant.id, 3),
  getAllProducts(db, tenant.id),
  getCategoriesBySite(db, tenant.id),
  getLastUpdatedDate(db, tenant.id),
  getHubsBySite(db, tenant.id),
]);
const byHubType: Record<string, Hub[]> = { "use-case": [], performance: [], value: [] };
for (const h of hubs) { byHubType[h.hub_type]?.push(h); }
const accentStyle = { backgroundColor: tenant.primaryColorDark };
const year = new Date().getFullYear();

// Popular head-to-head comparisons to surface on the home page.
//
// Goal: route Google's crawl equity from the home page (priority 1.0,
// daily changefreq) into the highest-converting template (H2H
// /compare/[slug]) and discoverable-because-already-in-sitemap URLs.
//
// Per GSC 90d ending 2026-08-07, the only paying query in the entire
// network is `sandisk extreme pro vs samsung t9` (1c / 3i / pos 10.3 /
// CTR 33%) landing on portablessds.com/compare/samsung-t9-portable-vs-sandisk-extreme-pro-portable.
// Five more portablessds H2H URLs receive impressions at pos 5-36 with
// 0 clicks. externalssds has zero H2H impressions — so the externalssds
// pairs below are curated for buyer-intent query coverage (T7 vs T9,
// T7 Shield vs SanDisk Extreme Pro, T9 vs SanDisk Extreme Pro, etc.).
//
// Slugs differ per tenant (e.g. portablessds uses `samsung-t7-portable`
// while externalssds uses `samsung-t7-shield`/`samsung-t9`/etc. without
// the systematic `-portable` suffix), so the candidate list is
// tenant-scoped. Each pair is canonicalized to the alphabetically-first
// slug form (per src/pages/sitemap.xml.ts:177 stable-order convention)
// so the home-page links match the URLs Google has already discovered
// in the sitemap.
const H2H_CANDIDATES: Record<string, Array<[string, string]>> = {
  portablessds: [
    ["samsung-t9-portable", "sandisk-extreme-pro-portable"], // the converting one — top placement
    ["crucial-x9-pro", "samsung-t7-portable"],
    ["crucial-x9-pro", "samsung-t7-shield-portable"],
    ["crucial-x9-pro", "sandisk-extreme-pro-portable"],
    ["crucial-x9-pro", "samsung-t9-portable"],
    ["samsung-t7-portable", "samsung-t9-portable"],          // curated: t7 vs t9 buyer intent
    ["sandisk-extreme-pro-portable", "samsung-t7-shield-portable"], // curated: rugged vs rugged
    ["samsung-t7-portable", "sandisk-extreme-pro-portable"],  // curated: flagship vs flagship
  ],
  externalssds: [
    ["samsung-t7-shield-4tb", "sandisk-extreme-pro-4tb"],     // 4TB rugged vs 4TB rugged
    ["samsung-t9", "samsung-t7-shield"],                      // premium vs rugged sibling
    ["samsung-t9", "sandisk-extreme-pro-portable-2tb"],       // Gen 2x2 vs Gen 2
    ["samsung-t7-shield-4tb", "samsung-t9-4tb"],              // 4TB buyer intent
    ["crucial-x9-pro-2tb", "samsung-t7-2tb"],                 // 2TB value buyer intent
    ["samsung-t7-shield", "samsung-t9"],                     // base vs base
    ["samsung-t7-2tb", "samsung-t7-shield-2tb"],              // T7 vs T7 Shield sibling
    ["samsung-t7-shield", "sandisk-extreme-pro-portable-1tb"],
  ],
};

// Resolve candidate pairs to live product pairs for the current tenant.
// Pairs where either slug is missing/inactive are silently dropped —
// the section is conditionally rendered only if >=1 pair resolves.
// Multiple candidate pairs that canonicalize to the same H2H href are
// deduped (preserving first occurrence), so the home page never shows
// two cards pointing at the same URL.
const candidatePairs = H2H_CANDIDATES[tenant.id] || [];
const pairLookups = await Promise.all(
  candidatePairs.flatMap(([a, b]) => [
    getProductBySlug(db, tenant.id, a).then((p): [string, Product | null] => [a, p]),
    getProductBySlug(db, tenant.id, b).then((p): [string, Product | null] => [b, p]),
  ])
);
const slugToProduct = new Map<string, Product | null>(pairLookups);
type LivePair = { productA: Product; productB: Product; href: string; orderedSlugA: string; orderedSlugB: string };
const liveH2H: LivePair[] = [];
const seenH2HHrefs = new Set<string>();
for (const [a, b] of candidatePairs) {
  const productA = slugToProduct.get(a) || null;
  const productB = slugToProduct.get(b) || null;
  if (!productA || !productB) continue;
  // Stable-alphabetical slug ordering to match sitemap.xml.ts emission
  const [first, second] = a < b ? [a, b] : [b, a];
  const href = `/compare/${first}-vs-${second}`;
  if (seenH2HHrefs.has(href)) continue;
  seenH2HHrefs.add(href);
  liveH2H.push({
    productA,
    productB,
    href,
    orderedSlugA: first,
    orderedSlugB: second,
  });
}

const topPicks = tenant.id === "portablessds"
  ? [
      { href: "/compare", label: "Compare all portable SSDs side-by-side →" },
      { href: "/hubs/best-portable-ssd-for-console-gaming", label: "Best portable SSD for console gaming →" },
      { href: "/hubs/cheapest-1tb-portable-ssd", label: "Cheapest 1TB portable SSDs ranked →" },
    ]
  : [
      { href: "/compare", label: "Compare all external SSDs side-by-side →" },
      { href: "/hubs/best-ssd-for-ps5", label: "Best external SSD for PS5 gaming →" },
      { href: "/hubs/cheapest-1tb-external-ssd", label: "Cheapest 1TB external SSDs ranked →" },
    ];
---

<BaseLayout title={tenant.id === "portablessds" ? `Top Portable SSDs ${year} - Expert Reviews, Prices & Comparisons` : `Best External SSDs ${year} - Expert Reviews, Prices & Comparisons`}>
  <HeroSection tenant={tenant} productCount={allProducts.length} lastUpdated={lastUpdated} />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <p class="text-xs text-surface-700 italic leading-relaxed">
        As an Amazon Associate I earn from qualifying purchases. We may earn a commission from qualifying purchases made through links on this site. Prices and availability are subject to change. We are reader-supported and independent — our rankings are based on an objective scoring rubric, not sponsorship.
      </p>
    </div>

    <nav class="flex flex-wrap items-center gap-2 mb-8 pb-5 border-b border-surface-300" aria-label="Quick navigation">
      <span class="text-xs font-semibold text-surface-700 uppercase tracking-wider mr-1">Quick links:</span>
      <a href="/compare" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50 transition-colors">Compare SSDs</a>
      <a href="/products" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50 transition-colors">All {tenant.name}</a>
      <a href="/hubs" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50 transition-colors">Buying Guides</a>
      <a href="/about" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50 transition-colors">About Us</a>
      {categories.slice(0, 3).map((cat) => (
        <a href={`/compare?category=${cat.slug}`} class="px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50 transition-colors">{cat.name}</a>
      ))}
    </nav>

    <section class="mb-12 grid gap-3 sm:grid-cols-3 text-sm">
      {topPicks.map((pick, i) => {
        const badgeClasses = [
          "bg-blue-100 text-blue-800",
          "bg-indigo-100 text-indigo-800",
          "bg-emerald-100 text-emerald-900",
        ];
        return (
          <a href={pick.href} class="flex items-center gap-2 rounded-lg border border-surface-500 p-3 hover:border-surface-700 hover:bg-surface-50 transition-colors no-underline">
            <span class={`w-8 h-8 rounded-full ${badgeClasses[i]} flex items-center justify-center text-xs font-bold shrink-0`}>{i + 1}</span>
            <span class="text-surface-700 font-medium">{pick.label}</span>
          </a>
        );
      })}
    </section>

    {topRated.length > 0 && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
          <h2 class="text-2xl font-bold text-surface-900">Best {tenant.name}</h2>
        </div>
        <AffiliateDisclosure className="mb-4" />
        <ProductGrid products={topRated} showRank />
      </section>
    )}

    {allProducts.length > 0 && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
          <h2 class="text-2xl font-bold text-surface-900">Most Popular</h2>
        </div>
        <p class="text-sm text-surface-700 mb-4">Trending SSDs with the most interest from shoppers comparing specs and prices.</p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {allProducts.slice(0, 6).map((p) => {
            const cap = p.capacity_gb >= 1000 ? `${(p.capacity_gb / 1000).toFixed(p.capacity_gb % 1000 === 0 ? 0 : 1)}TB` : `${p.capacity_gb}GB`;
            return (
              <a
                href={`/products/${p.slug}`}
                class="rounded-xl border border-surface-500 p-4 hover:shadow-md hover:-translate-y-0.5 hover:border-surface-700 transition-all no-underline group"
              >
                <p class="text-xs font-medium text-surface-700 uppercase tracking-wider">{p.brand_name}</p>
                <h3 class="text-sm font-bold text-surface-900 group-hover:text-blue-800 transition-colors mt-0.5">{p.name} {cap}</h3>
                <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-2 text-xs text-surface-700">
                  <span>{p.read_speed_mbps.toLocaleString()} MB/s read</span>
                  <span>{p.interface}</span>
                </div>
                <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-blue-800 opacity-0 group-hover:opacity-100 transition-opacity">
                  See price & review
                  <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {liveH2H.length > 0 && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
          <h2 class="text-2xl font-bold text-surface-900">Popular Head-to-Head Comparisons</h2>
        </div>
        <p class="text-sm text-surface-700 mb-4">Side-by-side verdicts on the {tenant.name.toLowerCase()} buyers compare most — specs, speed, and value scores in one place.</p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {liveH2H.map((pair) => {
            const scoreA = pair.productA.overall_score.toFixed(1);
            const scoreB = pair.productB.overall_score.toFixed(1);
            const winnerIsA = pair.productA.overall_score > pair.productB.overall_score;
            const winnerIsB = pair.productB.overall_score > pair.productA.overall_score;
            return (
              <a
                href={pair.href}
                class="rounded-xl border border-surface-500 p-4 hover:shadow-md hover:-translate-y-0.5 hover:border-surface-700 transition-all no-underline group flex flex-col"
              >
                <p class="text-xs font-medium text-surface-700 uppercase tracking-wider mb-1">Head-to-Head</p>
                <h3 class="text-sm font-bold text-surface-900 group-hover:text-blue-800 transition-colors">{pair.productA.name} vs {pair.productB.name}</h3>
                <p class="mt-1 text-xs text-surface-700 flex-1">Which is faster & better value?</p>
                <div class="mt-3 flex items-center gap-3 text-xs">
                  <span class={`px-2 py-0.5 rounded font-semibold ${winnerIsA ? "bg-emerald-100 text-emerald-900" : "bg-surface-100 text-surface-700"}`}>{pair.productA.brand_name} {scoreA}</span>
                  <span class="text-surface-500 font-medium">vs</span>
                  <span class={`px-2 py-0.5 rounded font-semibold ${winnerIsB ? "bg-emerald-100 text-emerald-900" : "bg-surface-100 text-surface-700"}`}>{pair.productB.brand_name} {scoreB}</span>
                </div>
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-blue-800 opacity-0 group-hover:opacity-100 transition-opacity">
                  See full verdict
                  <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
        <h2 class="text-2xl font-bold text-surface-900">Browse by Category</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((cat) => (
          <a
            href={`/compare?category=${cat.slug}`}
            class="rounded-xl border border-surface-500 p-5 hover:shadow-md hover:-translate-y-0.5 hover:border-surface-700 transition-all no-underline group flex flex-col"
          >
            <h3 class="text-base font-semibold text-surface-900 group-hover:text-blue-800 transition-colors">{cat.name}</h3>
            {cat.description && (
              <p class="mt-1 text-sm text-surface-700 flex-1">{cat.description}</p>
            )}
            <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-blue-800 opacity-0 group-hover:opacity-100 transition-opacity">
              Compare {cat.name}
              <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    {allProducts.length > 3 && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
          <h2 class="text-2xl font-bold text-surface-900">All {tenant.name} — {allProducts.length} Drives</h2>
        </div>
        <AffiliateDisclosure className="mb-4" />
        <ProductGrid products={allProducts} />
        <div class="mt-4 text-sm text-surface-700 text-center">
          Browse every drive: <a href="/products" class="text-blue-800 hover:text-blue-900 font-medium">see the full directory of all {allProducts.length} reviewed {tenant.name.toLowerCase()}</a>, or jump to individual reviews:
          {allProducts.slice(0, 5).map((p, i) => (
            <><a href={`/products/${p.slug}`} class="text-blue-800 hover:text-blue-900 font-medium">{p.name}</a>{i < Math.min(allProducts.length, 5) - 1 ? ", " : ""}</>
          ))}
          {allProducts.length > 5 && <> and <a href="/compare" class="text-blue-800 hover:text-blue-900 font-medium">compare all {allProducts.length} drives</a></>}
        </div>
      </section>
    )}

    {byHubType["use-case"]?.length > 0 && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
          <h2 class="text-2xl font-bold text-surface-900">Buying Guides</h2>
        </div>
        <p class="text-surface-700 text-sm mb-4">Find the best {tenant.name.toLowerCase()} for your specific needs.</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {byHubType["use-case"].map((hub) => (
            <a
              href={`/hubs/${hub.slug}`}
              class="rounded-xl border border-surface-500 p-5 hover:shadow-md hover:-translate-y-0.5 hover:border-surface-700 transition-all no-underline group flex flex-col"
            >
              <h3 class="text-base font-semibold text-surface-900 group-hover:text-blue-800 transition-colors">{hub.name}</h3>
              {hub.description && (
                <p class="mt-1 text-sm text-surface-700 line-clamp-2 flex-1">{hub.description}</p>
              )}
            </a>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="/hubs" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-800 hover:text-blue-900 transition-colors">
            Browse All Buying Guides & Ranked Lists
            <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </section>
    )}

    <section class="mb-12">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
        <h2 class="text-2xl font-bold text-surface-900">Popular Comparisons</h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 text-sm">
        {categories.slice(0, 3).map((cat) => (
          <a href={`/compare?category=${cat.slug}`} class="rounded-lg border border-surface-500 p-3 hover:border-surface-700 hover:bg-surface-50 transition-colors no-underline text-surface-800 font-medium flex items-center min-h-[44px]">{cat.name} Compared</a>
        ))}
        <a href="/compare" class="rounded-lg border border-surface-500 p-3 hover:border-surface-700 hover:bg-surface-50 transition-colors no-underline text-surface-800 font-medium flex items-center min-h-[44px]">All {tenant.name} Side-by-Side</a>
      </div>
    </section>

    {(byHubType["performance"]?.length > 0 || byHubType["value"]?.length > 0) && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
          <h2 class="text-2xl font-bold text-surface-900">Rankings & Comparisons</h2>
        </div>
        <p class="text-surface-700 text-sm mb-4">Performance rankings and value comparisons to help you decide.</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {[...(byHubType["performance"] || []), ...(byHubType["value"] || [])].map((hub) => (
            <a
              href={`/hubs/${hub.slug}`}
              class="rounded-xl border border-surface-500 p-5 hover:shadow-md hover:-translate-y-0.5 hover:border-surface-700 transition-all no-underline group flex flex-col"
            >
              <h3 class="text-base font-semibold text-surface-900 group-hover:text-blue-800 transition-colors">{hub.name}</h3>
              {hub.description && (
                <p class="mt-1 text-sm text-surface-700 line-clamp-2 flex-1">{hub.description}</p>
              )}
            </a>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="/hubs" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-800 hover:text-blue-900 transition-colors">
            View All Performance & Value Rankings
            <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </section>
    )}

  </div>
</BaseLayout>
