---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import GeoAffiliateLink from "@components/GeoAffiliateLink.astro";
import PriceStamp from "@components/PriceStamp.astro";
import ProductGrid from "@components/ProductGrid.astro";
import { getTopRatedProducts, getProductPricesFresh, getCategoriesBySite, getHubByCategory } from "@lib/db";
import { getLowestPrice } from "@lib/pricing";
import type { Product, Price } from "@lib/db";

const { DB, tenant, hostname, marketplace } = Astro.locals;
const { slug } = Astro.params;
const db = DB!;

const categories = await getCategoriesBySite(db, tenant.id);
const category = categories.find((c) => c.slug === slug);
if (!category) {
  return Astro.redirect("/404");
}

const products = await getTopRatedProducts(db, tenant.id, 10);
const categoryProducts = products.filter((p) => p.category_slug === slug);
const displayProducts = categoryProducts.length > 0 ? categoryProducts.slice(0, 6) : products.slice(0, 6);

const pricesByProduct: Record<number, Price[]> = {};
for (const p of displayProducts) {
  pricesByProduct[p.id] = await getProductPricesFresh(db, p.id, { marketplace, inStockOnly: true });
}

const speeds = displayProducts.map((p) => p.read_speed_mbps);
const minSpeed = Math.min(...speeds);
const maxSpeed = Math.max(...speeds);

const categoryName = category.name.replace(/\s+SSDs?$/i, "");
const metaDesc = `Our expert picks for the best ${categoryName.toLowerCase()} external SSDs in 2026. Compare top-rated drives with speeds, prices, and buying recommendations.`;

const categoryHub = await getHubByCategory(db, tenant.id, slug!);
const canonicalOverride = categoryHub ? `https://${hostname}/hubs/${categoryHub.slug}` : undefined;

const bestJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `Best ${categoryName} External SSDs 2026`,
  description: metaDesc,
  numberOfItems: displayProducts.length,
  itemListElement: displayProducts.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: p.name,
      url: `https://${hostname}/products/${p.slug}`,
      description: p.description,
      brand: { "@type": "Brand", name: p.brand_name },
      // Pol §5(t): customer reviews/star ratings prohibited unless via PA API
      // or Creators API. Surface our editorial score as a single Review.
      review: {
        "@type": "Review",
        author: { "@type": "Organization", name: tenant.name },
        reviewRating: { "@type": "Rating", ratingValue: p.overall_score, bestRating: 10, worstRating: 0 },
      },
    },
  })),
};

function getEditorialContent(catSlug: string, prods: Product[]): { intro: string; verdict: string; useCase: string } {
  const top = prods[0];
  const topName = top ? `${top.brand_name} ${top.name}` : "";
  const speeds = prods.map((p) => p.read_speed_mbps);
  const avgSpeed = speeds.reduce((a, b) => a + b, 0) / speeds.length;

  const intros: Record<string, string> = {
    "usb-c": `USB-C external SSDs offer universal compatibility with modern laptops, MacBooks, and desktops. These drives deliver fast transfer speeds over the same cable that charges your devices, making them the most versatile choice for everyday use. Our top pick, ${topName}, earned ${top?.overall_score.toFixed(1) || "N/A"}/10 for its balance of speed, build quality, and value.`,
    thunderbolt: `Thunderbolt external SSDs push the limits of external storage with 40 Gbps bandwidth. These professional-grade drives are essential for creative workflows involving 4K/8K video editing, large dataset processing, and high-resolution photography. The ${topName} leads our rankings with ${top ? (top.read_speed_mbps / 1000).toFixed(1) : "N/A"} GB/s read speeds.`,
    gaming: `Gaming external SSDs transform your console or PC gaming experience with faster load times and seamless game library management. These drives store your entire game collection with quick access, eliminating the wait times of traditional HDDs. Our top gaming pick, ${topName}, delivers ${top ? (top.read_speed_mbps / 1000).toFixed(1) : "N/A"} GB/s speeds for optimal performance.`,
    "ultra-portable": `Ultra-portable SSDs pack serious storage into pocket-sized form factors. Perfect for mobile professionals, students, and anyone who needs reliable storage on the go. The ${topName} combines ${top ? (top.read_speed_mbps / 1000).toFixed(1) : "N/A"} GB/s speeds with an incredibly compact design.`,
    "high-speed": `High-speed portable SSDs deliver maximum throughput for demanding creative workflows. With speeds reaching ${(maxSpeed / 1000).toFixed(1)} GB/s, these drives handle 4K video editing, RAW photo processing, and large file transfers with ease. Our top speed pick, ${topName}, leads the pack with ${top ? (top.read_speed_mbps / 1000).toFixed(1) : "N/A"} GB/s reads.`,
    rugged: `Rugged portable SSDs combine durability with performance, featuring IP-rated water and dust resistance plus drop-proof construction. Essential for outdoor photography, field work, and travel. The ${topName} offers ${top ? (top.read_speed_mbps / 1000).toFixed(1) : "N/A"} GB/s speeds in a package built to survive the elements.`,
  };

  const verdicts: Record<string, string> = {
    "usb-c": "For most users, a USB-C external SSD offers the best balance of speed, compatibility, and value. Unless you specifically need Thunderbolt speeds, USB-C drives deliver more than enough performance for backups, file transfers, and everyday use.",
    thunderbolt: "Thunderbolt external SSDs are a worthwhile investment for creative professionals who regularly work with large files. The speed advantage over USB-C is significant for 4K/8K video editing and large dataset processing.",
    gaming: "Any modern external SSD will dramatically improve your gaming experience over an HDD. For PS5 and Xbox, prioritize capacity for storing multiple large games. For PC gaming, speed matters more for reducing load times.",
    "ultra-portable": "If portability is your top priority, these ultra-compact SSDs deliver surprising performance in packages that fit in your pocket. Perfect for laptop users who need extra storage without the bulk.",
    "high-speed": "High-speed SSDs are essential for creative professionals who can't afford to wait. The premium over standard USB-C drives is justified by dramatically reduced transfer times for large files.",
    rugged: "For outdoor enthusiasts, photographers, and field workers, a rugged SSD is non-negotiable. The peace of mind from IP-rated protection and drop resistance outweighs the slight premium over standard drives.",
  };

  const useCases: Record<string, string> = {
    "usb-c": "Best for: Laptop users, MacBook owners, everyday backups, and general file transfers.",
    thunderbolt: "Best for: Video editors, photographers, audio producers, and Mac workstation users.",
    gaming: "Best for: PS5, Xbox Series X|S, and PC gamers with large game libraries.",
    "ultra-portable": "Best for: Students, travelers, and mobile professionals who need pocket-sized storage.",
    "high-speed": "Best for: Content creators, 4K video editors, and power users with large file workflows.",
    rugged: "Best for: Outdoor photographers, field workers, travelers, and adventure enthusiasts.",
  };

  return {
    intro: intros[catSlug] || `Our expert picks for the best ${categoryName.toLowerCase()} external SSDs, ranked by speed, build quality, and value.`,
    verdict: verdicts[catSlug] || "Choose based on your specific needs for speed, capacity, and durability.",
    useCase: useCases[catSlug] || "Versatile external storage for a variety of use cases.",
  };
}

const editorial = getEditorialContent(slug!, displayProducts);
---

<BaseLayout title={`Best ${categoryName} External SSDs 2026 - Expert Picks & Reviews`} description={metaDesc} jsonLd={bestJsonLd} canonical={canonicalOverride}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Best SSDs", href: "/hubs" }, { label: `Best ${categoryName} SSDs` }]} />

    <div class="mb-6">
      <p class="text-xs text-surface-700 italic leading-relaxed">
        As an Amazon Associate I earn from qualifying purchases. We may earn a commission from qualifying purchases made through links on this page. Prices and availability are subject to change. We are reader-supported and independent — our rankings are based on an objective scoring rubric, not sponsorship.
      </p>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900">
        Best {categoryName} External SSDs in 2026
      </h1>
      <p class="mt-3 text-surface-700 max-w-3xl leading-relaxed">
        {editorial.intro}
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <section class="mb-8">
          <h2 class="text-xl font-semibold text-surface-900 mb-4">Our Top Picks</h2>
          <div class="space-y-6">
            {displayProducts.map((product, index) => {
              const prices = pricesByProduct[product.id] || [];
              const bestPrice = getLowestPrice(prices);
              const isTopPick = index === 0;
              return (
                <div class={`rounded-xl border p-5 ${isTopPick ? "border-amber-300 bg-amber-50/50" : "border-surface-300"}`}>
                  <div class="flex items-start gap-4">
                    <div class="shrink-0 w-10 h-10 rounded-full bg-surface-100 flex items-center justify-center">
                      <span class="text-sm font-bold text-surface-700">#{index + 1}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        {isTopPick && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                            <svg aria-hidden="true" class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            Top Pick
                          </span>
                        )}
                        <p class="text-sm font-medium text-surface-700 uppercase tracking-wider">{product.brand_name}</p>
                      </div>
                      <a href={`/products/${product.slug}`} class="text-lg font-bold text-surface-900 hover:text-blue-800 no-underline">
                        {product.name}
                      </a>
                      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-sm text-surface-700">
                        <span>{(product.read_speed_mbps / 1000).toFixed(1)} GB/s Read</span>
                        <span>{(product.write_speed_mbps / 1000).toFixed(1)} GB/s Write</span>
                        <span>{product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(0)}TB` : `${product.capacity_gb}GB`}</span>
                        <span>{product.interface}</span>
                      </div>
                      <div class="flex items-center gap-2 mt-2">
                        <span class="text-sm font-medium text-surface-900">{product.overall_score.toFixed(1)}/10</span>
                        <div class="w-24 h-2 bg-surface-100 rounded-full overflow-hidden">
                          <div class="h-full bg-blue-600 rounded-full" style={{ width: `${product.overall_score * 10}%` }}></div>
                        </div>
                      </div>
                      <p class="text-sm text-surface-700 mt-2">{product.description}</p>
                      <div class="flex items-center gap-4 mt-3">
                        {bestPrice && (
                          <>
                            <GeoAffiliateLink
                              url={bestPrice.affiliate_url || ""}
                              retailer={bestPrice.retailer}
                              label={`See Price on ${bestPrice.retailer} →`}
                              urlSource={bestPrice.url_source}
                              useCartExtend
                              className="text-sm font-semibold"
                            />
                            <PriceStamp fetchedAt={bestPrice.fetched_at} className="text-xs" />
                          </>
                        )}
                        <a href={`/products/${product.slug}`} class="text-sm text-blue-800 hover:text-blue-900">
                          Full Review →
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-semibold text-surface-900 mb-4">Buying Guide</h2>
          <div class="rounded-xl border border-surface-300 p-6 space-y-4">
            <div>
              <h3 class="text-base font-semibold text-surface-900 mb-2">What to Look For</h3>
              <ul class="space-y-2 text-surface-700">
                <li class="flex items-start gap-2">
                  <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span><strong>Speed:</strong> Look for at least 1000 MB/s read speeds for general use. Creative professionals should target 2000+ MB/s.</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span><strong>Capacity:</strong> 1TB is the sweet spot for most users. Consider 2TB+ for large game libraries or video projects.</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span><strong>Durability:</strong> For travel and outdoor use, look for IP55/IP65 ratings and drop resistance.</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  <span><strong>Warranty:</strong> 5-year warranties indicate manufacturer confidence. 3-year is standard.</span>
                </li>
              </ul>
            </div>
            <div>
              <h3 class="text-base font-semibold text-surface-900 mb-2">Our Verdict</h3>
              <p class="text-surface-700 leading-relaxed">{editorial.verdict}</p>
            </div>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="text-xl font-semibold text-surface-900 mb-4">Quick Comparison</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-surface-300">
                  <th class="text-left py-3 px-4 font-semibold text-surface-900">Product</th>
                  <th class="text-left py-3 px-4 font-semibold text-surface-900">Score</th>
                  <th class="text-left py-3 px-4 font-semibold text-surface-900">Read Speed</th>
                  <th class="text-left py-3 px-4 font-semibold text-surface-900">Capacity</th>
                  <th class="text-left py-3 px-4 font-semibold text-surface-900">Best Price</th>
                </tr>
              </thead>
              <tbody>
                {displayProducts.map((product) => {
                  const prices = pricesByProduct[product.id] || [];
                  const bestPrice = getLowestPrice(prices);
                  return (
                    <tr class="border-b border-surface-200 hover:bg-surface-50">
                      <td class="py-3 px-4">
                        <a href={`/products/${product.slug}`} class="text-blue-800 hover:text-blue-900 font-medium no-underline">
                          {product.name}
                        </a>
                      </td>
                      <td class="py-3 px-4 font-medium">{product.overall_score.toFixed(1)}/10</td>
                      <td class="py-3 px-4">{(product.read_speed_mbps / 1000).toFixed(1)} GB/s</td>
                      <td class="py-3 px-4">{product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(0)}TB` : `${product.capacity_gb}GB`}</td>
                      <td class="py-3 px-4">{bestPrice ? <a href={`/products/${product.slug}`} class="text-blue-800 hover:text-blue-900 font-medium">See Price →</a> : "N/A"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-8 space-y-4">
          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Best For</h3>
            <p class="text-sm text-surface-700">{editorial.useCase}</p>
          </div>

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Browse Categories</h3>
            <div class="space-y-2">
              {categories.map((cat) => (
                <a
                  href={`/best/${cat.slug}`}
                  class={`block px-3 py-2 text-sm rounded-lg transition-colors ${
                    cat.slug === slug
                      ? "bg-blue-50 text-blue-800 font-medium"
                      : "text-surface-700 hover:bg-surface-50"
                  }`}
                >
                  Best {cat.name.replace(/\s+SSDs?$/i, "")} SSDs
                </a>
              ))}
            </div>
          </div>

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Compare All</h3>
            <a
              href={`/compare?category=${slug}`}
              class="block w-full text-center py-2.5 text-sm font-semibold rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50"
            >
              Full Comparison Table
            </a>
          </div>

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Speed Stats</h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-surface-700">Fastest</span>
                <span class="font-medium text-surface-900">{(maxSpeed / 1000).toFixed(1)} GB/s</span>
              </div>
              <div class="flex justify-between">
                <span class="text-surface-700">Slowest</span>
                <span class="font-medium text-surface-900">{(minSpeed / 1000).toFixed(1)} GB/s</span>
              </div>
              <div class="flex justify-between">
                <span class="text-surface-700">Average</span>
                <span class="font-medium text-surface-900">{((speeds.reduce((a, b) => a + b, 0) / speeds.length) / 1000).toFixed(1)} GB/s</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>