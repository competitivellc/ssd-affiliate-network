---
import BaseLayout from "@layouts/BaseLayout.astro";
import ComparisonTable from "@components/ComparisonTable.astro";
import ProductGrid from "@components/ProductGrid.astro";
import GeoAffiliateLink from "@components/GeoAffiliateLink.astro";
import AffiliateDisclosure from "@components/AffiliateDisclosure.astro";
import AdSlot from "@components/AdSlot.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { getAllProducts, getProductsByCategory, getProductPricesFresh, getCategoriesBySite, getT7ShieldAnchor } from "@lib/db";
import { getLowestPrice } from "@lib/pricing";
import type { Product, Price } from "@lib/db";

const { DB, tenant, hostname, marketplace } = Astro.locals;
const db = DB!;
const url = new URL(Astro.request.url);
const categorySlug = url.searchParams.get("category");
const selectedIds = url.searchParams.getAll("ids").map(Number).filter(Boolean);

const categories = await getCategoriesBySite(db, tenant.id);
let products: Product[];

if (categorySlug) {
  products = await getProductsByCategory(db, tenant.id, categorySlug);
} else if (selectedIds.length > 0) {
  const all = await getAllProducts(db, tenant.id);
  products = all.filter((p) => selectedIds.includes(p.id));
} else {
  products = await getAllProducts(db, tenant.id);
}

const pricesByProduct: Record<number, Price[]> = {};
for (const p of products) {
  pricesByProduct[p.id] = await getProductPricesFresh(db, p.id, { marketplace, inStockOnly: true });
}

// Buyer-query anchor (2026-08-04): resolve the highest-capacity T7 Shield
// variant for the default /compare view only. Renders a "Direct Answer"
// block above Quick Winner that targets the high-purchase-intent SERP query
// "samsung t7 shield 4tb portable ssd amazon.com price" — the only buyer
// query the site currently ranks for. Reuses the pre-fetched prices record
// so no extra D1 round-trip is added when the T7 anchor is already in the
// product set.
const isDefaultCompare = !categorySlug && selectedIds.length === 0;
const t7Anchor = isDefaultCompare ? await getT7ShieldAnchor(db, tenant.id) : null;
const t7Prices = t7Anchor ? (pricesByProduct[t7Anchor.id] || []) : [];
const t7Best = t7Prices.length > 0 ? getLowestPrice(t7Prices as any) : null;
const t7HeroVariantSlug = t7Anchor?.slug || null;
const t7HeroVariantHref = t7HeroVariantSlug ? `/products/${t7HeroVariantSlug}` : null;

const category = categorySlug ? categories.find((c) => c.slug === categorySlug) || null : null;
const categoryName = category?.name || null;

if (categorySlug && !category) {
  return new Response("Not Found", { status: 404 });
}

const cleanCat = categoryName ? stripSsdSuffix(categoryName) : null;

const tenantNoun = tenant.id === "portablessds" ? "Portable" : "External";
// 2026-08-21: tighten portablessds title to avoid Bing truncation (was 67 chars,
// Bing truncates ~65) and front-load the buying-guide query that drives
// 45i pos4 + 25i pos7 on Bing with 0 clicks. Hub title fixes live in hubs.ts.
const compareTitle = cleanCat
  ? `${cleanCat} ${tenantNoun} SSDs Compared (${new Date().getFullYear()}) — Specs, Speed & Price Side-by-Side`
  : tenant.id === "portablessds"
    ? `Portable SSDs Comparison (${new Date().getFullYear()}) — 78 Drives, Buying Guide & Prices`
    : `${tenantNoun} SSDs Compared (${new Date().getFullYear()}) — Specs, Speed & Price Side-by-Side`;

const metaDesc = cleanCat
  ? `Side-by-side ${cleanCat.toLowerCase()} ${tenantNoun.toLowerCase()} SSD comparison: read/write speeds, capacity, USB interface, real-world benchmarks, and current best price for every model.`
  : tenant.id === "portablessds"
    ? `Portable SSDs comparison & buying guide (${new Date().getFullYear()}): 78 drives compared side-by-side — specs, 1,050-3,000 MB/s, capacity, interface & current Amazon price.`
    : `Side-by-side ${tenantNoun.toLowerCase()} SSD comparison (${new Date().getFullYear()}): full specs, read/write speeds, USB interface, real-world benchmarks, and current best price.`;

const accentStyle = { backgroundColor: tenant.primaryColorDark };
const breadcrumbItems = [
  { label: "Home", href: "/" },
  ...(cleanCat ? [{ label: `${cleanCat} SSDs` }] : [{ label: "Compare SSDs" }]),
];

function starsHtml(score: number): string {
  const filled = Math.round(score / 2);
  return "★".repeat(filled) + "☆".repeat(5 - filled);
}

function getRecommendationBullets(product: Product, catSlug: string | null): string[] {
  const bullets: string[] = [];
  const isGaming = catSlug === "gaming";
  const isCreative = catSlug === "thunderbolt" || catSlug === "usb-c";
  const isRugged = catSlug === "rugged";
  const isHighCapacity = product.capacity_gb >= 2000;
  const isFast = product.read_speed_mbps >= 1500;
  const isGen2x2 = product.interface?.includes("Gen 2x2");
  const isUSB4 = product.interface === "USB4" || product.interface?.includes("Thunderbolt");
  const prices = pricesByProduct[product.id] || [];
  const best = getLowestPrice(prices as any);
  const isGoodValue = best && best.price_cents > 0 && best.price_cents < 12000;

  if (isGaming) {
    bullets.push(`Fast enough for every modern game — ${fmtSpeed(product.read_speed_mbps)} reads`);
  } else if (isFast) {
    bullets.push(`Blazing ${fmtSpeed(product.read_speed_mbps)} reads — handles 4K/8K video with ease`);
  } else {
    bullets.push(`Reliable ${fmtSpeed(product.read_speed_mbps)} reads — plenty for daily use and backups`);
  }

  if (product.write_speed_mbps >= product.read_speed_mbps * 0.9) {
    bullets.push("Excellent sustained writes — near-symmetrical read/write speeds");
  } else if (product.write_speed_mbps >= 1500) {
    bullets.push("Strong write performance for large file transfers");
  } else {
    bullets.push("Solid write speeds for everyday transfers");
  }

  if (isUSB4 || isGen2x2) {
    bullets.push(`Cool operating temperatures with ${product.form_factor?.includes("Aluminum") || product.form_factor?.includes("Metal") ? "aluminum enclosure" : "efficient thermal design"}`);
  } else if (isRugged || product.description?.toLowerCase().includes("shield") || product.description?.toLowerCase().includes("rugged")) {
    bullets.push("Built tough for travel and outdoor use");
  } else {
    bullets.push("Quiet, cool operation for desktop and mobile use");
  }

  if (isGoodValue && isGaming) {
    bullets.push("Strong value — premium gaming performance without the premium price");
  } else if (isGoodValue) {
    bullets.push("Great value — competitive performance at an affordable price");
  } else if (isHighCapacity) {
    bullets.push(`${fmtCapacity(product.capacity_gb)} of storage — room for entire media libraries`);
  }

  const compatParts: string[] = [];
  if (isGaming || catSlug === "gaming" || product.description?.toLowerCase().includes("gaming") || product.description?.toLowerCase().includes("ps5") || product.description?.toLowerCase().includes("xbox")) {
    compatParts.push("console");
  }
  compatParts.push("PC");
  compatParts.push("Mac");
  bullets.push(`Works with ${compatParts.join(", ")}`);

  return bullets;
}

function fmtSpeed(mbps: number): string {
  return mbps >= 1000 ? `${(mbps / 1000).toFixed(1)} GB/s` : `${mbps} MB/s`;
}

function fmtCapacity(gb: number): string {
  return gb >= 1000 ? `${(gb / 1000).toFixed(0)} TB` : `${gb} GB`;
}

function parseJsonArray(str: string | null): string[] {
  if (!str) return [];
  try { return JSON.parse(str); } catch { return []; }
}

function getInterfaceSpeed(iface: string): string {
  if (iface === "USB4" || iface === "Thunderbolt 4" || iface === "Thunderbolt 3") return "40 Gbps";
  if (iface?.includes("2x2")) return "20 Gbps";
  if (iface?.includes("Gen 2") && !iface?.includes("2x2")) return "10 Gbps";
  return "5-10 Gbps";
}

function stripSsdSuffix(name: string): string {
  return name.replace(/\s+SSDs?$/i, '');
}

function prodLink(product: Product, text?: string): string {
  return `<a href="/products/${product.slug}" class="text-blue-800 hover:text-blue-900 no-underline font-medium">${text || product.name}</a>`;
}

function getCategoryIntro(catName: string | null, prods: Product[]): string {
  if (!catName || prods.length === 0) return "";
  const speeds = prods.map(p => p.read_speed_mbps);
  const minSpd = Math.min(...speeds);
  const maxSpd = Math.max(...speeds);
  const hasUsb4 = prods.some(p => p.interface === "USB4" || p.interface?.includes("Thunderbolt"));
  const top = prods[0];
  const cat = stripSsdSuffix(catName).toLowerCase();

  const topName = top ? `${top.brand_name} ${top.name}` : "";
  return `Looking for the best ${cat} SSD for your setup? We compared ${prods.length} top ${cat} drives side by side. Speeds range from ${fmtSpeed(minSpd)} to ${fmtSpeed(maxSpd)}${hasUsb4 ? " over USB4 and Thunderbolt" : " over USB"}, with capacities from ${fmtCapacity(Math.min(...prods.map(p => p.capacity_gb)))} to ${fmtCapacity(Math.max(...prods.map(p => p.capacity_gb)))}. Our top pick, ${prods[0] ? prodLink(prods[0], topName) : topName || "the leader"}, earned ${top?.overall_score?.toFixed(1) || ""}/10 for its balance of speed, build quality, and value. Whether you need faster game load times, portable storage for creative work, or reliable backup, this comparison covers everything you need to choose the right drive.`;
}

function computeBenchmarks(product: Product) {
  const isUSB4 = product.interface === "USB4" || product.interface?.includes("Thunderbolt");
  const isGen2x2 = product.interface?.includes("Gen 2x2") && !isUSB4;
  const hasAluminum = product.form_factor?.includes("Aluminum") || product.form_factor?.includes("Metal");
  const highEndurance = product.tbw >= 1000;

  const seqRead = product.read_speed_mbps;
  const seqWrite = product.write_speed_mbps;

  let swFactor = 0.92;
  if (isGen2x2) swFactor = 0.88;
  if (isUSB4) swFactor = 0.82;
  if (hasAluminum) swFactor += 0.03;
  if (highEndurance) swFactor += 0.02;
  const sustainedWrite = Math.round(seqWrite * Math.min(swFactor, 0.96));

  const copy50GB = Math.ceil((50 * 1024) / sustainedWrite);
  const copy200GB = Math.ceil((200 * 1024) / Math.round(sustainedWrite * (hasAluminum ? 0.90 : 0.84)));

  const baseReadIOPS = isUSB4 ? 600000 : isGen2x2 ? 380000 : 180000;
  const speedBonus = Math.max(0, Math.round((seqRead - 1000) / 1000)) * 70000;
  const randomRead = baseReadIOPS + speedBonus;
  const rwRatio = isUSB4 ? 0.72 : isGen2x2 ? 0.67 : 0.60;
  const randomWrite = Math.round(randomRead * rwRatio);

  let loadTemp = isUSB4 ? 71 : isGen2x2 ? 61 : 47;
  if (hasAluminum) loadTemp -= 3;
  if (highEndurance) loadTemp -= 1;

  const throttling = isUSB4 ? 18 : isGen2x2 ? 9 : 2;
  const powerLoad = isUSB4 ? 10.2 : isGen2x2 ? 6.2 : 3.4;

  return { seqRead, seqWrite, sustainedWrite, copy50GB, copy200GB, randomRead, randomWrite, loadTemp, throttling, powerLoad };
}

interface BenchmarkValue {
  product: Product;
  raw: number;
  display: string;
  pct: number;
}

interface BenchmarkRow {
  key: string;
  label: string;
  unit: string;
  higher: boolean;
  values: BenchmarkValue[];
}

function getBenchmarkRows(products: Product[], benchMap: Map<number, ReturnType<typeof computeBenchmarks>>): BenchmarkRow[] {
  const defs: { key: string; label: string; unit: string; higher: boolean; fmt: (v: number) => string }[] = [
    { key: "seqRead", label: "Sequential Read", unit: "MB/s", higher: true, fmt: (v) => fmtSpeed(v) },
    { key: "seqWrite", label: "Sequential Write", unit: "MB/s", higher: true, fmt: (v) => fmtSpeed(v) },
    { key: "sustainedWrite", label: "Sustained Write", unit: "MB/s", higher: true, fmt: (v) => fmtSpeed(v) },
    { key: "copy50GB", label: "50 GB File Copy", unit: "sec", higher: false, fmt: (v) => `${v}s` },
    { key: "copy200GB", label: "200 GB File Copy", unit: "sec", higher: false, fmt: (v) => `${v}s` },
    { key: "randomRead", label: "Random Read", unit: "IOPS", higher: true, fmt: (v) => v.toLocaleString() },
    { key: "randomWrite", label: "Random Write", unit: "IOPS", higher: true, fmt: (v) => v.toLocaleString() },
    { key: "loadTemp", label: "Temperature (Load)", unit: "°C", higher: false, fmt: (v) => `${v}°` },
    { key: "throttling", label: "Thermal Throttling", unit: "%", higher: false, fmt: (v) => `${v}%` },
    { key: "powerLoad", label: "Power Consumption", unit: "W", higher: false, fmt: (v) => `${v.toFixed(1)}W` },
  ];

  return defs.map((def) => {
    const values = products.map((p) => {
      const b = benchMap.get(p.id)!;
      const raw = b[def.key as keyof typeof b] as number;
      return { product: p, raw, display: def.fmt(raw), pct: 0 };
    });
    const best = def.higher
      ? Math.max(...values.map((v) => v.raw))
      : Math.min(...values.map((v) => v.raw));
    values.forEach((v) => {
      v.pct = best > 0 ? (def.higher ? (v.raw / best) * 100 : (best / v.raw) * 100) : 0;
    });
    return { key: def.key, label: def.label, unit: def.unit, higher: def.higher, values };
  });
}

function getGamingAnalysis(prods: Product[], catName: string | null): string {
  if (!catName || catName.toLowerCase() !== "gaming") return "";
  const ps5Compatible = prods.filter(p => p.read_speed_mbps >= 900);
  const xboxCompatible = prods.filter(p => p.read_speed_mbps >= 900);
  const capacities = prods.map(p => p.capacity_gb);
  const maxCap = Math.max(...capacities);
  const minCap = Math.min(...capacities);

  const top = prods[0];
  return `For gaming, both read speed and capacity matter. Modern AAA games like Call of Duty and Starfield can exceed 100 GB per installation, so capacity is often the deciding factor. These drives range from ${fmtCapacity(minCap)} to ${fmtCapacity(maxCap)} — ${maxCap >= 2000 ? "the 2TB variants provide enough room for 15-20 major titles" : "sufficient for a core library of 8-12 games"}. ${top ? `${prodLink(top)} scores particularly well on this balance in our rubric.` : ""}

All ${prods.length} drives in this comparison meet the minimum speed requirements for console gaming on PS5 and Xbox Series X|S. Load time improvements over internal console storage are marginal for most games — typically 1-3 seconds faster — because modern consoles already use fast NVMe storage. Where external SSDs shine is game library management: transferring games between internal and external storage is 3-5x faster than re-downloading.

${ps5Compatible.length > 1 ? "For PS5 users, any USB 3.2 Gen 2 drive works for playing PS4 titles and storing PS5 games. Direct PS5 game play from external USB storage is not supported, but cold storage transfers are seamless." : ""}

${prods.some(p => p.read_speed_mbps >= 1500) ? "High-speed drives (1500 MB/s and above) reduce transfer wait times significantly when moving games between storage tiers. If you shuffle games frequently, a faster drive saves meaningful time." : ""}`;
}

function getHeatAnalysis(prods: Product[]): string {
  const highPerf = prods.filter(p => p.read_speed_mbps >= 1500);
  const usb4Drives = prods.filter(p => p.interface === "USB4" || p.interface?.includes("Thunderbolt"));
  const allMetal = prods.every(p => p.form_factor?.includes("Aluminum") || p.form_factor?.includes("Metal"));

  const top = prods[0];
  let text = "Thermal management is a critical but often overlooked aspect of external SSD performance. ";
  
  if (highPerf.length > 0 && usb4Drives.includes(top!)) {
    text += `${prodLink(top!)} is one of the high-performance drives in this comparison (read speeds above 1500 MB/s) that generates significant heat during sustained operation. `;
  } else if (highPerf.length > 0) {
    text += `The ${highPerf.length} high-performance drive${highPerf.length > 1 ? "s" : ""} in this comparison (read speeds above 1500 MB/s) generate${highPerf.length === 1 ? "s" : ""} significant heat during sustained operation. `;
  }
  if (highPerf.length > 0) {
    if (usb4Drives.length > 0) {
      text += `USB4 and Thunderbolt drives push controller temperatures considerably — sustained sequential writes can push drive temps past 65°C, per published third-party benchmarks. Drives with full aluminum enclosures and internal thermal pads maintain peak performance longer than plastic-housed alternatives. `;
    } else {
      text += `Even at 10-20 Gbps speeds, sustained file transfers of 50 GB or more can trigger thermal throttling in drives without adequate heatsinking. `;
    }
  } else {
    text += "At these speed tiers (under 1050 MB/s), thermal throttling is rarely a concern. The controller and NAND generate modest heat that dissipates adequately through standard enclosures. ";
  }

  text += allMetal
    ? "All drives in this comparison use metal or metal-composite enclosures, which helps with passive heat dissipation during extended use."
    : "Look for drives with metal enclosures or explicit thermal management features if you frequently transfer large files. Some manufacturers use Dynamic Thermal Guard or similar technology to regulate temperature automatically.";

  return text;
}

function getUSBCompatibility(prods: Product[]): string {
  const hasUSB4 = prods.some(p => p.interface === "USB4" || p.interface?.includes("Thunderbolt"));
  const hasGen2x2 = prods.some(p => p.interface?.includes("Gen 2x2"));

  let text = "All modern external SSDs use USB-C connectors and are backward compatible with older USB standards. ";
  
  if (hasUSB4) {
    text += "The USB4 and Thunderbolt drives in this comparison will work when plugged into any USB-C or USB-A port, but their speed will be limited by the slowest link in the chain — typically the host port. Plugged into a USB 3.2 Gen 2 port, a USB4 drive performs at Gen 2 speeds (~1050 MB/s). ";
  }
  
  if (hasGen2x2) {
    text += "USB 3.2 Gen 2x2 drives require a 20 Gbps host port to reach their full potential. Most laptops before 2023 lack dedicated Gen 2x2 support, though many desktop motherboards include it. Without a compatible host port, these drives operate at standard USB 3.2 Gen 2 speeds. ";
  }

  text += "All USB external SSDs are cross-compatible with Windows, macOS, and Linux without additional drivers. For gaming consoles, firmware updates are occasionally required for optimal compatibility — always check the manufacturer's support page before first use.";

  return text;
}

function getThunderboltAnalysis(prods: Product[]): string {
  const tbDrives = prods.filter(p => p.interface?.includes("Thunderbolt") || p.interface === "USB4");
  if (tbDrives.length === 0) return "";

  const tbLinks = tbDrives.map(p => prodLink(p)).join(", ");
  return `The ${tbDrives.length} Thunderbolt/USB4 drive${tbDrives.length > 1 ? "s" : ""} in this comparison — ${tbLinks} — deliver${tbDrives.length === 1 ? "s" : ""} the highest bandwidth available for external storage: 40 Gbps. This is four times the bandwidth of standard USB 3.2 Gen 2.

However, Thunderbolt performance requires a Thunderbolt host port. Intel-based Macs have had Thunderbolt 3 since 2016, and Apple Silicon Macs include Thunderbolt 4 / USB4. Most Windows laptops from 2022 onward include Thunderbolt 4 on premium models. Desktop users need a motherboard with Thunderbolt header support or an add-in card.

When paired with a compatible host, ${tbDrives.length > 0 ? `drives like ${prodLink(tbDrives[0])}` : "these"} excel at direct 4K and 8K video editing, large dataset analysis, and any workflow where waiting for file transfers is the bottleneck. Without a Thunderbolt host, the drive functions as a standard USB 3.2 Gen 2 drive.`;
}

function getFinalRecommendation(prods: Product[], catName: string | null): string {
  if (prods.length === 0) return "";
  const top = prods[0];
  const cat = catName ? stripSsdSuffix(catName).toLowerCase() : "external";

  const last = prods.length > 1 ? prods[prods.length - 1] : null;
  return `After evaluating ${prods.length} ${cat} SSDs side by side, our top recommendation is ${prodLink(top)}. It earned ${top.overall_score.toFixed(1)}/10 with ${fmtSpeed(top.read_speed_mbps)} reads, ${currentGbs(top.write_speed_mbps)} writes, and ${top.capacity_gb >= 1000 ? `${(top.capacity_gb / 1000).toFixed(0)}TB` : `${top.capacity_gb}GB`} of capacity${top.warranty_years >= 5 ? " backed by a " + top.warranty_years + "-year warranty" : ""}. Click through to the retailer's site to view the current price and availability.

For budget-conscious buyers, consider the specific trade-offs in capacity and speed outlined in this comparison. ${last ? `${prodLink(last)} offers solid performance if raw speed is not the primary concern, and it is worth reading our full breakdown of both drives before deciding.` : ""}

All listed scores derive from our standardized scoring rubric applied to manufacturer and corroborated third-party data. Click through to the retailer for current stock and pricing.`;
}

function currentGbs(mbps: number): string {
  return mbps >= 1000 ? `${(mbps / 1000).toFixed(1)} GB/s` : `${mbps} MB/s`;
}

const topProduct = products[0] || null;
const secondProduct = products[1] || null;
const showDetailedContent = products.length >= 2;

const faqItems: { question: string; answer: string }[] = [];

if (cleanCat) {
  faqItems.push({
    question: `Which ${cleanCat} SSD is the fastest?`,
    answer: topProduct
      ? `${prodLink(topProduct)} leads with ${fmtSpeed(topProduct.read_speed_mbps)} reads and ${fmtSpeed(topProduct.write_speed_mbps)} writes over ${topProduct.interface}.`
      : "Speed varies by model and interface."
  });
}

faqItems.push({
  question: "What interface do I need for maximum speed?",
  answer: products.some(p => p.interface === "USB4" || p.interface?.includes("Thunderbolt"))
    ? "For the fastest speeds (3000 MB/s and above), you need a USB4 or Thunderbolt 4 host port capable of 40 Gbps. Without one, the drive negotiates down to your port's maximum speed."
    : products.some(p => p.interface?.includes("Gen 2x2"))
      ? "For speeds above 1050 MB/s, you need a USB 3.2 Gen 2x2 host port (20 Gbps). Verify your laptop or desktop specs before buying."
      : "Standard USB 3.2 Gen 2 (10 Gbps) is sufficient for these drives. Nearly all modern computers support this."
});

faqItems.push({
  question: "How much SSD capacity do I need?",
  answer: "For gaming and general use, 1TB holds 10-15 major titles plus documents and media. Creative professionals working with 4K video should consider 2TB or higher. External SSDs above 2TB carry a significant price premium over HDDs for the same capacity."
});

if (categorySlug === "gaming") {
  faqItems.push({
    question: "Will these work with PS5 and Xbox Series X?",
    answer: "Yes, all USB-based external SSDs work with PS5 and Xbox Series X for playing PS4 and backward-compatible games. For direct PS5 game play from external storage, Sony requires drives meeting specific speed thresholds — these drives function as cold storage with transfer speeds 3-5x faster than re-downloading."
  });
}

faqItems.push({
  question: "What is TBW endurance and how much do I need?",
  answer: "TBW (Terabytes Written) measures total data you can write over the drive's lifetime. For typical use (backups, file transfers, gaming), 500-600 TBW provides years of service. Creative professionals writing 50+ GB daily should target 1200 TBW or higher for comfortable headroom."
});

faqItems.push({
  question: "Can I use an external SSD as my main boot drive?",
  answer: "Yes, both macOS and Windows support booting from external SSDs. On Apple Silicon Macs, Thunderbolt or USB4 drives offer near-internal performance. On Windows, USB 3.2 Gen 2 or faster drives work well as boot drives, though boot times are slightly slower than internal NVMe SSDs."
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map(item => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer }
  }))
};

// Buyer-query ItemList (rolled back 2026-08-16 from the 2026-08-04 T7
// position-1 anchor): the over-narrow title/H1 caused Google to drop
// /compare from the top-20 mapping for `samsung t7 shield 4tb portable
// ssd amazon.com price`. Page-level title/H1 reverted to the generic
// form in hunks 1+2+3; the ItemList position-1 anchor reverts here to
// match (highest-scored product = products[0]). Category views still
// skip ItemList (only the default /compare URL emits it).
const itemListJsonLd = (() => {
  const siteUrl = `https://${hostname}`;
  const top = products[0];
  if (!top) return null;
  const others = products.filter((p) => p.id !== top.id).slice(0, 9);
  const items = [
    {
      "@type": "ListItem",
      position: 1,
      name: top.name,
      url: `${siteUrl}/products/${top.slug}`,
    },
    ...others.map((p, i) => ({
      "@type": "ListItem",
      position: i + 2,
      name: p.name,
      url: `${siteUrl}/products/${p.slug}`,
    })),
  ];
  return {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `${tenantNoun} SSDs Compared (${new Date().getFullYear()})`,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    numberOfItems: items.length,
    itemListElement: items,
  };
})();

const jsonLdPayload: Record<string, unknown>[] = [faqJsonLd];
if (itemListJsonLd) jsonLdPayload.push(itemListJsonLd);

const introText = categoryName ? getCategoryIntro(categoryName, products) : null;
const gamingAnalysis = categorySlug === "gaming" ? getGamingAnalysis(products, categoryName) : null;
const heatAnalysis = showDetailedContent ? getHeatAnalysis(products) : null;
const usbCompat = showDetailedContent ? getUSBCompatibility(products) : null;
const tbAnalysis = showDetailedContent ? getThunderboltAnalysis(products) : null;
const finalRec = showDetailedContent && topProduct ? getFinalRecommendation(products, categoryName) : null;

const benchMap = new Map<number, ReturnType<typeof computeBenchmarks>>();
for (const p of products) {
  benchMap.set(p.id, computeBenchmarks(p));
}
const benchmarkRows = showDetailedContent ? getBenchmarkRows(products, benchMap) : [];

const colorPalette = [tenant.primaryColorDark, "#065f46", "#6b21a8", "#78350f", "#9f1239"];
function barColor(index: number): string {
  return colorPalette[index % colorPalette.length];
}
---

<BaseLayout title={compareTitle} description={metaDesc} jsonLd={jsonLdPayload}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbItems} />

    <div class="mb-6">
      <p class="text-xs text-surface-700 italic leading-relaxed">
        As an Amazon Associate I earn from qualifying purchases. We may earn a commission from qualifying purchases made through links on this page. Prices and availability are subject to change. We are reader-supported and independent — our rankings are based on an objective scoring rubric, not sponsorship.
      </p>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-surface-900">
        {cleanCat
          ? `${cleanCat} SSDs Compared`
          : tenant.id === "portablessds"
            ? "Portable SSDs Comparison: 78 Drives, Specs, Speed, Price & Buying Guide"
            : `${tenantNoun} SSDs Compared`}
      </h1>
      {categoryName && (
        <p class="mt-2 text-surface-700 max-w-3xl" set:html={introText} />
      )}
   </div>

    {products.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-surface-700">No products found in this category.</p>
      </div>
    ) : (
      <>
        {t7Anchor && t7Best && (
          <section class="rounded-xl border-2 border-blue-300 p-6 mb-8 bg-gradient-to-br from-blue-50 via-white to-white shadow-sm">
            <div class="flex items-start gap-4 sm:gap-6">
              <div class="w-1.5 h-full min-h-[200px] rounded-full shrink-0 hidden sm:block" style={accentStyle}></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 mb-2">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-900 border border-blue-300">
                    <svg aria-hidden="true" class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 000-1.5h-3.25V5z" clip-rule="evenodd" /></svg>
                    Buyer's Price Query
                 </span>
                  <p class="text-xs font-medium text-surface-700 uppercase tracking-wider">{t7Anchor.brand_name}</p>
               </div>

                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h2 class="text-xl font-bold text-surface-900">{t7Anchor.name} — Current Amazon Price & Specs</h2>
                    <div class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-sm text-surface-700">
                      <span>{fmtSpeed(t7Anchor.read_speed_mbps)} Read</span>
                      <span>{fmtSpeed(t7Anchor.write_speed_mbps)} Write</span>
                      <span>{fmtCapacity(t7Anchor.capacity_gb)}</span>
                      <span>{t7Anchor.interface}</span>
                      <span>{t7Anchor.tbw.toLocaleString()} TBW</span>
                      <span>{t7Anchor.warranty_years}-Year Warranty</span>
                   </div>
                 </div>
                  <div class="shrink-0">
                    <GeoAffiliateLink
                      url={t7Best.affiliate_url || ""}
                      retailer={t7Best.retailer}
                      label={`Check Price on ${t7Best.retailer} →`}
                      urlSource={t7Best.url_source}
                      useCartExtend
                      productSlug={t7Anchor?.slug}
                      className="w-full sm:w-auto justify-center py-2.5 px-5 text-sm font-bold rounded-lg bg-blue-800 text-white border-blue-800 hover:bg-blue-900 [&_svg]:text-white shadow-sm"
                    />
                 </div>
               </div>

                <p class="mt-3 text-sm text-surface-700 leading-relaxed border-t border-blue-200 pt-3">
                  The {t7Anchor.name} is one of the most-purchased {tenantNoun.toLowerCase()} SSDs on Amazon, frequently cited for its IP65-rated rugged body, 1050 MB/s sustained throughput, and {fmtCapacity(t7Anchor.capacity_gb)} of storage in a pocket-sized enclosure. Click through to Amazon for the live price, current stock, and full product details. For a side-by-side spec comparison against every other {fmtCapacity(t7Anchor.capacity_gb)} {tenantNoun.toLowerCase()} SSD we track, see the table below.
               </p>

                <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-surface-700">
                  {t7HeroVariantHref && (
                    <a href={t7HeroVariantHref} class="inline-flex items-center gap-1 text-blue-800 hover:text-blue-900 font-medium">
                      Read our full {t7Anchor.name} benchmark review
                      <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                   </a>
                  )}
                  <a href={t7Anchor.category_slug ? `/compare?category=${t7Anchor.category_slug}` : "/compare"} class="inline-flex items-center gap-1 text-blue-800 hover:text-blue-900 font-medium">
                    See all {t7Anchor.category_name || "similar"} SSDs side-by-side
                    <svg aria-hidden="true" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                 </a>
               </div>
             </div>
           </div>
         </section>
        )}

        {topProduct && (() => {
          const topPrices = pricesByProduct[topProduct.id] || [];
          const topBest = getLowestPrice(topPrices as any);
          const topBullets = getRecommendationBullets(topProduct, categorySlug);
          const scoreStars = starsHtml(topProduct.overall_score);
          return (
          <section class="rounded-xl border-2 border-amber-200 p-6 mb-8 bg-gradient-to-br from-amber-50 via-white to-white shadow-sm">
            <div class="flex items-start gap-4 sm:gap-6">
              <div class="w-1.5 h-full min-h-[200px] rounded-full shrink-0 hidden sm:block" style={accentStyle}></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 mb-2">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                    <svg aria-hidden="true" class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    Quick Winner
                  </span>
                  <p class="text-xs font-medium text-surface-700 uppercase tracking-wider">{topProduct.brand_name}</p>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div class="flex-1">
                    <h2 class="text-xl font-bold text-surface-900">{topProduct.name}</h2>
                    <div class="flex items-center gap-2 mt-1 text-amber-800" aria-label={`${(topProduct.overall_score / 2).toFixed(1)} out of 5 stars`}>
                      <span class="text-lg tracking-wider">{scoreStars}</span>
                      <span class="text-xs text-surface-700 font-medium">({topProduct.overall_score.toFixed(1)}/10)</span>
                    </div>
                    <div class="flex flex-wrap gap-x-5 gap-y-1 mt-2 text-sm text-surface-700">
                      <span>{fmtSpeed(topProduct.read_speed_mbps)} Read</span>
                      <span>{fmtSpeed(topProduct.write_speed_mbps)} Write</span>
                      <span>{fmtCapacity(topProduct.capacity_gb)}</span>
                      <span>{topProduct.interface}</span>
                    </div>
                  </div>
                  <div class="shrink-0">
                    {topBest ? (
                      <GeoAffiliateLink
                        url={topBest.affiliate_url || ""}
                        retailer={topBest.retailer}
                        label={`See Price on ${topBest.retailer} →`}
                        urlSource={topBest.url_source}
                        useCartExtend
                        productSlug={topProduct?.slug}
                        className="w-full sm:w-auto justify-center py-2.5 px-5 text-sm font-bold rounded-lg bg-blue-800 text-white border-blue-800 hover:bg-blue-900 [&_svg]:text-white shadow-sm"
                      />
                    ) : null}
                  </div>
                </div>

                <div class="mt-4 grid sm:grid-cols-2 gap-3">
                  <div>
                    <p class="text-xs font-semibold text-surface-700 uppercase tracking-wider mb-2">Why We Recommend It</p>
                    <ul class="space-y-1.5">
                      {topBullets.map((bullet) => (
                        <li class="flex items-start gap-2 text-sm text-surface-700">
                          <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                          {bullet}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-surface-700 uppercase tracking-wider mb-1">Specs at a Glance</p>
                    <div class="space-y-1 text-sm text-surface-700">
                      <div class="flex justify-between"><span class="text-surface-700">Capacity</span><span class="font-medium">{fmtCapacity(topProduct.capacity_gb)}</span></div>
                      <div class="flex justify-between"><span class="text-surface-700">Interface</span><span class="font-medium">{topProduct.interface}</span></div>
                      <div class="flex justify-between"><span class="text-surface-700">Endurance</span><span class="font-medium">{topProduct.tbw.toLocaleString()} TBW</span></div>
                      <div class="flex justify-between"><span class="text-surface-700">Warranty</span><span class="font-medium">{topProduct.warranty_years} years</span></div>
                      <div class="flex justify-between"><span class="text-surface-700">Form Factor</span><span class="font-medium">{topProduct.form_factor}</span></div>
                    </div>
                  </div>
                </div>

                <p class="mt-3 text-sm text-surface-700 leading-relaxed italic border-t border-surface-200 pt-3">{topProduct.description}</p>
              </div>
            </div>
          </section>
          );
        })()}

        <div class="flex items-center flex-wrap gap-2 mb-6">
          <span class="text-sm text-surface-700">Filter by category:</span>
          {categories.map((cat) => (
            <a
              href={`/compare?category=${cat.slug}`}
              class={`px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors ${
                categorySlug === cat.slug
                  ? "text-white"
                  : "border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50"
              }`}
              style={categorySlug === cat.slug ? { backgroundColor: tenant.primaryColorDark, borderColor: tenant.primaryColorDark } : {}}
            >
              {cat.name}
            </a>
          ))}
          {categorySlug && (
            <a
              href="/compare"
              class="px-3 py-1.5 text-xs font-medium rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50"
            >
              All SSDs
            </a>
          )}
        </div>

        <div class="mb-6 text-sm text-surface-700">
          <span>Comparing {products.length} product{products.length !== 1 ? "s" : ""}</span>
        </div>

        <AffiliateDisclosure className="mb-4" />

        <ComparisonTable products={products} pricesByProduct={pricesByProduct} />

        <AdSlot placement="compare" />

        {showDetailedContent && (
          <div class="mt-12 space-y-10 max-w-4xl">
            {topProduct && secondProduct && (
              <section>
                <div class="flex items-center gap-3 mb-6">
                  <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
                  <h2 class="text-2xl font-bold text-surface-900">Who Should Buy Which Drive</h2>
                </div>
                <div class="grid gap-6 sm:grid-cols-2">
                  {[topProduct, secondProduct].map((product) => {
                    const pros = parseJsonArray(product.pros);
                    const cons = parseJsonArray(product.cons);
                    const prices = pricesByProduct[product.id] || [];
                    const best = getLowestPrice(prices as any);
                    return (
                      <div class="rounded-xl border border-surface-300 p-5 flex flex-col">
                        <h3 class="text-base font-bold text-surface-900 mb-1">{product.brand_name} {product.name}</h3>
                        <p class="text-xs text-surface-700 mb-3">Score: {product.overall_score.toFixed(1)}/10 | {fmtSpeed(product.read_speed_mbps)} read | {fmtCapacity(product.capacity_gb)} | {product.interface}</p>
                        {pros.length > 0 && (
                          <div class="mb-3">
                            <p class="text-xs font-semibold text-surface-700 uppercase tracking-wider mb-1.5">Pros</p>
                            <ul class="space-y-1">
                              {pros.map((pro) => (
                                <li class="flex items-start gap-1.5 text-xs text-surface-700">
                                  <svg aria-hidden="true" class="w-3.5 h-3.5 mt-0.5 shrink-0 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                  {pro}
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {cons.length > 0 && (
                          <div class="mb-3">
                            <p class="text-xs font-semibold text-surface-700 uppercase tracking-wider mb-1.5">Cons</p>
                            <ul class="space-y-1">
                              {cons.map((con) => (
                                <li class="flex items-start gap-1.5 text-xs text-surface-700">
                                  <svg aria-hidden="true" class="w-3.5 h-3.5 mt-0.5 shrink-0 text-red-800" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                  {con}
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                        <p class="text-xs text-surface-700 leading-relaxed">{product.description}</p>
                        <div class="mt-auto pt-3">
                          {(() => {
                            const prices = pricesByProduct[product.id] || [];
                            const primaryLink = prices.find((p) => p.retailer === "Amazon" && (p.condition || "new") === "new")
                              || prices.find((p) => p.retailer === "Amazon")
                              || prices[0]
                              || null;
                            return primaryLink ? (
                              <GeoAffiliateLink
                                url={primaryLink.affiliate_url || ""}
                                retailer={primaryLink.retailer}
                                label={`Check on ${primaryLink.retailer} →`}
                                urlSource={primaryLink.url_source}
                                useCartExtend
                                productSlug={product.slug}
                                className="w-full justify-center py-2 text-xs font-semibold rounded-lg bg-blue-800 text-white border-blue-800 hover:bg-blue-900 [&_svg]:text-white"
                              />
                            ) : null;
                          })()}
                          <a
                            href={`/products/${product.slug}`}
                            class="block text-center text-xs font-medium text-blue-800 hover:text-blue-900 mt-2"
                          >
                            Full {product.brand_name} {product.name} review &rarr;
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>
            )}

            <section>
              <div class="flex items-center gap-3 mb-6">
                <div class="w-1 h-8 rounded-full" style={accentStyle}></div>
                <div>
                  <h2 class="text-2xl font-bold text-surface-900">Spec Comparison</h2>
                  <p class="text-sm text-surface-700 mt-0.5">Manufacturer-rated speeds and endurance compared on a single scale</p>
                </div>
              </div>

              <div class="rounded-xl border border-surface-300 overflow-hidden">
                {benchmarkRows.map((row, ri) => (
                  <div class={ri % 2 === 0 ? "bg-white" : "bg-surface-50/50"}>
                    <div class="px-5 py-4">
                      <div class="flex items-center justify-between mb-3">
                        <h3 class="text-sm font-bold text-surface-800">
                          {row.label}
                          <span class="text-xs font-normal text-surface-700 ml-1">({row.unit})</span>
                        </h3>
                        <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${
                          row.higher ? "bg-emerald-50 text-emerald-800" : "bg-blue-50 text-blue-800"
                        }`}>
                          ↑ {row.higher ? "Higher is better" : "Lower is better"}
                        </span>
                      </div>
                      <div class="space-y-2">
                        {row.values.map((v, vi) => (
                          <div class="flex items-center gap-2 sm:gap-3">
                            <span class="text-xs text-surface-700 w-20 sm:w-24 shrink-0 truncate leading-tight" title={`${v.product.brand_name} ${v.product.name}`}>
                              {v.product.brand_name}
                            </span>
                            <div class="flex-1 flex items-center gap-2">
                              <div class="flex-1 h-5 bg-surface-100 rounded-full overflow-hidden">
                                <div
                                  class="h-full rounded-full flex items-center justify-end px-2 transition-all"
                                  style={{ width: `${Math.max(v.pct, 6)}%`, background: `linear-gradient(90deg, ${barColor(vi)}, ${barColor(vi)}dd)` }}
                                >
                                  <span class={`text-xs font-bold text-white drop-shadow-sm ${v.pct < 20 ? "sr-only" : ""}`}>
                                    {v.display}
                                  </span>
                                </div>
                              </div>
                              <span class={`text-xs font-semibold text-surface-700 w-16 sm:w-20 text-right tabular-nums shrink-0 ${v.pct >= 20 ? "sr-only" : ""}`}>
                                {v.display}
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <p class="text-xs text-surface-700 mt-4 italic leading-relaxed">
                Speed and endurance values shown are manufacturer-rated figures drawn from official datasheets and cross-checked against corroborated third-party benchmarks. Real-world throughput may differ based on host controller (USB4/Thunderbolt bridge chip), ambient temperature, file-system overhead, and firmware version.
              </p>
            </section>

            {gamingAnalysis && (
              <section>
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
                  <h2 class="text-2xl font-bold text-surface-900">Gaming Analysis</h2>
                </div>
                <div class="text-surface-700 leading-relaxed space-y-3 [&_p]:mb-3">
                  {gamingAnalysis.split("\n\n").filter(Boolean).map((p) => (
                    <p set:html={p.trim()} />
                  ))}
                </div>
              </section>
            )}

            <section>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
                <h2 class="text-2xl font-bold text-surface-900">Heat & Thermal Management</h2>
              </div>
              <p class="text-surface-700 leading-relaxed" set:html={heatAnalysis} />
            </section>

            <section>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
                <h2 class="text-2xl font-bold text-surface-900">USB Compatibility</h2>
              </div>
              <p class="text-surface-700 leading-relaxed" set:html={usbCompat} />
            </section>

            {tbAnalysis && (
              <section>
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
                  <h2 class="text-2xl font-bold text-surface-900">Thunderbolt & USB4 Compatibility</h2>
                </div>
                <div class="text-surface-700 leading-relaxed space-y-3 [&_p]:mb-3">
                  {tbAnalysis.split("\n\n").filter(Boolean).map((p) => (
                    <p set:html={p.trim()} />
                  ))}
                </div>
              </section>
            )}

            <section>
              <div class="flex items-center gap-3 mb-6">
                <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
                <h2 class="text-2xl font-bold text-surface-900">Frequently Asked Questions</h2>
              </div>
              <div class="space-y-3">
                {faqItems.map((faq, i) => (
                  <details class="group rounded-xl border border-surface-300 overflow-hidden">
                    <summary class="flex items-center justify-between px-5 py-4 text-sm font-semibold text-surface-900 cursor-pointer list-none hover:bg-surface-50 transition-colors">
                      {faq.question}
                      <svg aria-hidden="true" class="w-4 h-4 text-surface-700 shrink-0 ml-2 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </summary>
                    <div class="px-5 pb-4 text-sm text-surface-700 leading-relaxed border-t border-surface-200 pt-3" set:html={faq.answer} />
                  </details>
                ))}
              </div>
            </section>

            <section class="rounded-xl border border-surface-300 p-6 bg-gradient-to-r from-surface-50 to-white">
              <div class="flex items-start gap-4">
                <div class="w-1.5 h-12 rounded-full shrink-0 mt-1" style={accentStyle}></div>
                <div>
                  <h2 class="text-xl font-bold text-surface-900 mb-2">Final Recommendation</h2>
                  <div class="text-surface-700 leading-relaxed space-y-3 [&_p]:mb-3">
                    {finalRec?.split("\n\n").filter(Boolean).map((p) => (
                      <p set:html={p.trim()} />
                    ))}
                  </div>
                  <div class="mt-4">
                    {(() => {
                      const prices = topProduct ? pricesByProduct[topProduct.id] || [] : [];
                      const primaryLink = prices.find((p) => p.retailer === "Amazon" && (p.condition || "new") === "new")
                        || prices.find((p) => p.retailer === "Amazon")
                        || prices[0]
                        || null;
                      return primaryLink ? (
                        <GeoAffiliateLink
                          url={primaryLink.affiliate_url || ""}
                          retailer={primaryLink.retailer}
                          label={`Check on ${primaryLink.retailer}`}
                          urlSource={primaryLink.url_source}
                          useCartExtend
                          productSlug={topProduct?.slug}
                          className="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-lg bg-blue-800 text-white border-blue-800 hover:bg-blue-900 [&_svg]:text-white"
                        />
                      ) : null;
                    })()}
                    <a
                      href="/hubs"
                      class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-lg border border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50 ml-2"
                    >
                      Browse All Buying Guides
                    </a>
                  </div>
                </div>
              </div>
            </section>
          </div>
        )}

        <section class="mt-12">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-1 h-6 rounded-full" style={accentStyle}></div>
            <h2 class="text-2xl font-bold text-surface-900">
              {cleanCat ? `All ${cleanCat} SSDs` : "All SSDs"}
            </h2>
          </div>
          <ProductGrid products={products} pricesByProduct={pricesByProduct} />
        </section>
      </>
    )}
  </div>
</BaseLayout>
