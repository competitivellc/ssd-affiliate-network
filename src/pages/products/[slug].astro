---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import GeoAffiliateLink from "@components/GeoAffiliateLink.astro";
import ProductGrid from "@components/ProductGrid.astro";
import { getProductBySlug, getProductPricesFresh, getProductsByBrand, getRelatedProducts, getHubsForProduct } from "@lib/db";
import type { Hub } from "@lib/db";
import { classifyDrive } from "@lib/editorial";

const { DB, tenant, hostname, marketplace } = Astro.locals;
const { slug } = Astro.params;
const db = DB!;

// Cannibalization consolidation (2026-07-30): the two Samsung T7 Shield
// product URLs were stealing impressions + link equity from /compare,
// which already ranks pos 6-7 for the high-value buyer query
// "samsung t7 shield 4tb portable ssd amazon.com price".
// 301 the product URLs to /compare so all ranking signal consolidates
// onto the URL that actually converts.
if (slug === "samsung-t7-shield" || slug === "samsung-t7-shield-portable") {
  return Astro.redirect("/compare", 301);
}

const product = await getProductBySlug(db, tenant.id, slug!);
if (!product) {
  return Astro.redirect("/404");
}

// Phase 1 compliance fix (2026-08-03): We no longer display explicit prices
// ($X.XX) on product pages. Without PAAPI access we cannot guarantee price
// freshness, and Pol §2(b) restricts price DISPLAY accuracy. Instead we
// render only a "Check on Amazon" affiliate link — Amazon's own page shows
// the live price. The prices table still holds Special Link URLs (used for
// affiliate tag injection via GeoAffiliateLink) but price_cents is never
// rendered on-page.
const allPrices = await getProductPricesFresh(db, product.id, { marketplace, inStockOnly: true });
const amazonNew = allPrices.find((p) => p.retailer === "Amazon" && (p.condition || "new") === "new");
const amazonUsed = allPrices.find((p) => p.retailer === "Amazon" && p.condition === "used");
const otherRetailers = allPrices.filter(
  (p) => p.retailer !== "Amazon" || (p.condition && p.condition !== "new")
).filter((p) => p !== amazonUsed);

// Best affiliate link target — used ONLY for the GeoAffiliateLink href, never
// for price display. Even stale prices produce valid Special Links (the tag
// is injected at render time by buildAffiliateUrl).
const primaryLink = amazonNew || allPrices.find((p) => p.retailer === "Amazon") || allPrices[0] || null;

const brandProducts = product.brand_id
  ? await getProductsByBrand(db, tenant.id, product.brand_id, product.id)
  : [];
const relatedProducts = product.category_id
  ? (await getRelatedProducts(db, tenant.id, product.category_id, product.id)).slice(0, 3)
  : [];
const productHubs: Hub[] = await getHubsForProduct(db, tenant.id, product, 4);

const scoreColor =
  product.overall_score >= 9
    ? "text-emerald-800 bg-emerald-50"
    : product.overall_score >= 8
    ? "text-blue-800 bg-blue-50"
    : "text-amber-900 bg-amber-50";

const scoreBgColor =
  product.overall_score >= 9
    ? "bg-emerald-50"
    : product.overall_score >= 8
    ? "bg-blue-50"
    : "bg-amber-50";

const productUrl = `https://${hostname}/products/${product.slug}`;
const siteUrl = `https://${hostname}`;

const capacityLabel = product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(product.capacity_gb % 1000 === 0 ? 0 : 1)}TB` : `${product.capacity_gb}GB`;
const currentYear = new Date().getFullYear();
const bandwidthLabel = product.read_speed_mbps >= 1000 ? `${(product.read_speed_mbps / 1000).toFixed(1)} GB/s` : `${product.read_speed_mbps} MB/s`;

const tenantNoun = tenant.id === "portablessds" ? "Portable" : "External";

const productPageTitle = `${product.name} ${capacityLabel} ${tenantNoun} SSD Review (${currentYear}) — ${product.read_speed_mbps.toLocaleString()} MB/s Reads`;
const productPageDesc = `${product.name} ${capacityLabel} ${tenantNoun.toLowerCase()} SSD review (${currentYear}): ${product.read_speed_mbps.toLocaleString()} MB/s reads, ${product.write_speed_mbps.toLocaleString()} MB/s writes, ${product.interface || "USB"} interface, real-world benchmarks, full specs, and where to buy.`;

const pros: string[] = product.pros ? JSON.parse(product.pros) : [];
const cons: string[] = product.cons ? JSON.parse(product.cons) : [];

const productJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": productUrl,
  name: `${product.name} ${capacityLabel} Portable SSD`,
  description: product.description,
  mpn: product.model || product.slug,
  ...(product.gtin13 ? { gtin13: product.gtin13 } : {}),
  brand: {
    "@type": "Brand",
    name: product.brand_name,
  },
  image: `${siteUrl}/favicon-external.svg`,
  category: product.category_name,
  // Editorial authored review (not aggregate); Pol §5(t) line 393 prohibits
  // displaying customer reviews/star ratings unless sourced via PA API or
  // Creators API. Our overall_score is editorial, exposed as a single Review.
  "review": {
    "@type": "Review",
    author: { "@type": "Organization", name: tenant.name },
    reviewRating: {
      "@type": "Rating",
      ratingValue: Math.round(product.overall_score / 2 * 10) / 10,
      bestRating: 5,
      worstRating: 1,
    },
  },
  // Phase 1 compliance fix (2026-08-03): Offer schema removed. Without PAAPI
  // access we cannot guarantee price freshness, so we do not emit structured
  // price data. The Product + Review (editorial) schema remains. When PAAPI
  // access is earned, re-add Offer with live API-sourced price_cents.
  ...(primaryLink
    ? {
        offers: {
          "@type": "Offer",
          availability: "https://schema.org/InStock",
          url: productUrl,
        },
      }
    : {
        offers: {
          "@type": "Offer",
          availability: "https://schema.org/OutOfStock",
          url: productUrl,
        },
      }),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    ...(product.category_name
      ? [{ "@type": "ListItem", position: 2, name: product.category_name, item: `${siteUrl}/compare?category=${product.category_slug}` }]
      : []),
    { "@type": "ListItem", position: product.category_name ? 3 : 2, name: product.name, item: productUrl },
  ],
};

function xferTime(mbps: number, fileGb: number): string {
  const s = (fileGb * 1000) / mbps;
  if (s < 1) return "under a second";
  if (s < 60) return `~${Math.round(s)} seconds`;
  return `~${Math.round(s / 60)} minutes`;
}

const isRugged = /\b(shield|extreme|rugged|armor|tough)\b/i.test(product.name);
const isGaming = product.category_slug === "gaming" || /\b(gaming|xbox|playstation|console)\b/i.test(product.name);
const isHighSpeed = product.read_speed_mbps >= 1500;
const isUSB4 = product.interface === "USB4" || product.interface?.includes("Thunderbolt");
const isGen2x2 = product.interface?.includes("Gen 2x2");
const isHighCapacity = product.capacity_gb >= 2000;

const transfer50gb = xferTime(product.write_speed_mbps, 50);
const transfer100gb = xferTime(product.write_speed_mbps, 100);
const transfer200gb = xferTime(product.write_speed_mbps, 200);

const topCompetitor = relatedProducts[0] || null;

const archetype = classifyDrive(product);

const faqEntries = [
  {
    q: `What are the read and write speeds of the ${product.name}?`,
    a: `The ${product.name} ${capacityLabel} delivers sequential read speeds of ${product.read_speed_mbps.toLocaleString()} MB/s and write speeds of ${product.write_speed_mbps.toLocaleString()} MB/s over its ${product.interface} interface.`,
  },
  {
    q: `What interface does the ${product.name} use?`,
    a: `The ${product.name} uses a ${product.interface} interface with a theoretical maximum bandwidth of ${bandwidthLabel}.`,
  },
  {
    q: `How much storage does the ${product.name} ${capacityLabel} hold?`,
    a: `The ${product.name} provides ${capacityLabel} of usable storage, enough for approximately ${Math.floor(product.capacity_gb / 50)} hours of 4K video or ${Math.floor(product.capacity_gb / 4)} large game installs.`,
  },
  {
    q: `What is the endurance rating of the ${product.name}?`,
    a: `The ${product.name} is rated for ${product.tbw.toLocaleString()} TBW (terabytes written) endurance, backed by a ${product.warranty_years}-year limited warranty from ${product.brand_name}.`,
  },
  {
    q: `Is the ${product.name} compatible with PlayStation 5 and Xbox?`,
    a: `Yes, the ${product.name} works with PlayStation 5, Xbox Series X|S, and other consoles that support external USB storage. It can store and play games directly from the drive.`,
  },
  {
    q: `How long will the ${product.name} last?`,
    a: `The ${product.name} is rated for ${product.tbw.toLocaleString()} TBW endurance with a ${product.warranty_years}-year warranty. For typical daily use — backups, file transfers, and game storage — this translates to many years of reliable service before approaching the endurance limit.`,
  },
  {
    q: `What capacity ${product.name} should I buy?`,
    a: product.capacity_gb >= 2000
      ? `The ${capacityLabel} capacity is ideal for users with large media libraries, extensive game collections, or creative professionals working with 4K video. If you primarily store documents and photos, a smaller capacity may suffice — but the ${capacityLabel} provides room to grow without worrying about running out of space.`
      : `A ${capacityLabel} drive works well for everyday backups, game storage for10-15 titles, and general file transport. If you work with large video files or need to store an extensive game library, consider a higher-capacity model in the same product line.`,
  },
  {
    q: `Does the ${product.name} work with Mac and PC?`,
    a: `Yes, the ${product.name} is compatible with macOS, Windows, and Linux out of the box. No additional drivers are required. On macOS, you may need to format the drive to APFS or Mac OS Extended (Journaled) depending on your workflow.`,
  },
  {
    q: isRugged
      ? `Is the ${product.name} waterproof and dustproof?`
      : `How durable is the ${product.name}?`,
    a: isRugged
      ? `The ${product.name} features IP-rated dust and water resistance along with drop protection. It is built to survive the bumps and conditions of outdoor use, travel, and field work — unlike standard external drives that are vulnerable to physical damage.`
      : `The ${product.name} is designed for everyday portability with a compact form factor. While it does not carry a specific IP rating for water and dust resistance, the ${product.form_factor} construction provides reasonable protection during normal use and transport.`,
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqEntries.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const calloutBg: Record<string, string> = {
  "elite-pro-creator": "bg-purple-50 border-purple-200",
  "console-gaming": "bg-indigo-50 border-indigo-200",
  "rugged-portable": "bg-amber-50 border-amber-200",
  "highspeed-usb-pro": "bg-sky-50 border-sky-200",
  "budget-everyday": "bg-surface-50 border-surface-200",
};
const calloutText: Record<string, string> = {
  "elite-pro-creator": "text-purple-800",
  "console-gaming": "text-indigo-800",
  "rugged-portable": "text-amber-900",
  "highspeed-usb-pro": "text-sky-800",
  "budget-everyday": "text-surface-800",
};
---

<BaseLayout
  title={productPageTitle}
  description={productPageDesc}
  jsonLd={[productJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <p class="text-xs text-surface-700 italic leading-relaxed">
        As an Amazon Associate I earn from qualifying purchases. We may earn a commission from qualifying purchases made through links on this page. Prices and availability are subject to change. We are reader-supported and independent — our rankings are based on an objective scoring rubric, not sponsorship.
      </p>
    </div>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            ...(product.category_slug
              ? [{ label: product.category_name, href: `/compare?category=${product.category_slug}` }]
              : []),
            { label: product.name },
          ]}
        />

        <div class="flex items-start justify-between mb-6">
          <div>
            <p class="text-sm font-medium text-surface-700 uppercase tracking-wider">{product.brand_name}</p>
            <h1 class="text-2xl sm:text-3xl font-bold text-surface-900 mt-0.5">{product.name} {capacityLabel} {tenantNoun} SSD</h1>
            {product.model && (
              <p class="text-sm text-surface-700 mt-1">Model: {product.model}</p>
            )}
          </div>
          <div class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-bold ${scoreBgColor} ${scoreColor}`}>
            <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            {product.overall_score.toFixed(1)}/10
          </div>
        </div>

        <div class="rounded-xl border border-surface-300 overflow-hidden mb-8">
          <table class="compare-grid">
            <tbody>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50 w-40">Capacity</td>
                <td class="text-surface-900 font-medium">{product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(0)}TB` : `${product.capacity_gb}GB`}</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Interface</td>
                <td class="text-surface-900">{product.interface}</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Form Factor</td>
                <td class="text-surface-900">{product.form_factor}</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Read Speed</td>
                <td class="text-surface-900 font-mono font-medium">{product.read_speed_mbps.toLocaleString()} MB/s</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Write Speed</td>
                <td class="text-surface-900 font-mono font-medium">{product.write_speed_mbps.toLocaleString()} MB/s</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Endurance (TBW)</td>
                <td class="text-surface-900">{product.tbw.toLocaleString()} TB</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Warranty</td>
                <td class="text-surface-900">{product.warranty_years} Years</td>
              </tr>
            </tbody>
          </table>
        </div>

        {product.description && (
          <section class="mb-6">
            <h2 class="text-xl font-semibold text-surface-900 mb-3">Overview</h2>
            <p class="text-surface-700 leading-relaxed">{product.description}</p>
            <p class="text-sm text-surface-700 mt-2">
              See how it stacks up against competitors in our <a href={`/compare?category=${product.category_slug}`} class="text-blue-800 hover:text-blue-900 font-medium">{product.category_name} SSD comparison</a>, or browse related <a href="/hubs" class="text-blue-800 hover:text-blue-900 font-medium">SSD buying guides</a>.
            </p>
          </section>
        )}

        <section class="mb-8 rounded-xl border border-surface-300 p-5">
          <h2 class="text-xl font-semibold text-surface-900 mb-3">Where to Buy</h2>
          <p class="text-sm text-surface-700 mb-3">
            Click through to view the current price, availability, and full product details on the retailer's site.
          </p>
          {primaryLink && (
            <GeoAffiliateLink
              url={primaryLink.affiliate_url || ""}
              retailer={primaryLink.retailer}
              label={`Check on ${primaryLink.retailer} →`}
              urlSource={primaryLink.url_source}
              useCartExtend
              className="mb-4 text-sm"
            />
          )}
          {(amazonUsed || otherRetailers.length > 0) && (
            <div class="mt-4 pt-4 border-t border-surface-200">
              <p class="text-xs font-semibold text-surface-700 uppercase tracking-wider mb-2">Other retailers</p>
              <div class="space-y-1.5">
                {amazonUsed && (
                  <GeoAffiliateLink
                    url={amazonUsed.affiliate_url || ""}
                    retailer={amazonUsed.retailer}
                    label={`Amazon (used) →`}
                    urlSource={amazonUsed.url_source}
                    className="text-sm"
                  />
                )}
                {otherRetailers.map((price) => (
                  <GeoAffiliateLink
                    url={price.affiliate_url || ""}
                    retailer={price.retailer}
                    label={`${price.retailer}${price.condition === "used" ? " (used)" : ""} →`}
                    urlSource={price.url_source}
                    className="text-sm"
                  />
                ))}
              </div>
            </div>
          )}
          <p class="text-xs text-surface-700 mt-4 italic">
            We earn a commission from qualifying purchases made through these links. Prices and availability are subject to change — see the retailer's site for current pricing.
          </p>
        </section>

        <div class="grid sm:grid-cols-2 gap-6 mb-8">
          {pros.length > 0 && (
            <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-4">
              <h3 class="text-sm font-semibold text-emerald-800 mb-2">Pros</h3>
              <ul class="space-y-1">
                {pros.map((pro: string) => (
                  <li class="flex items-start gap-2 text-sm text-emerald-800">
                    <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {pro}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {cons.length > 0 && (
            <div class="rounded-xl border border-red-200 bg-red-50/50 p-4">
              <h3 class="text-sm font-semibold text-red-800 mb-2">Cons</h3>
              <ul class="space-y-1">
                {cons.map((con: string) => (
                  <li class="flex items-start gap-2 text-sm text-red-800">
                    <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-red-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    {con}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <section class="mb-8 space-y-5">
          <div>
            <h2 class="text-xl font-semibold text-surface-900 mb-1">{archetype.label} Analysis</h2>
            <p class="text-surface-700 leading-relaxed">{archetype.tagline}</p>
          </div>

          {archetype.blocks.map((block) => (
            <>
              {block.type === "prose" && (
                <div>
                  {block.title && (
                    <h3 class="text-base font-semibold text-surface-800 mb-1.5">{block.title}</h3>
                  )}
                  <p class="text-surface-700 leading-relaxed">{block.content}</p>
                </div>
              )}
              {block.type === "bullets" && (
                <div>
                  {block.title && (
                    <h3 class="text-base font-semibold text-surface-800 mb-1.5">{block.title}</h3>
                  )}
                  <ul class="space-y-1">
                    {block.items.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-surface-700">
                        <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-surface-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {block.type === "callout" && (
                <div class={`rounded-lg border ${calloutBg[archetype.id]} px-4 py-3`}>
                  <p class={`text-sm ${calloutText[archetype.id]}`}>{block.content}</p>
                </div>
              )}
            </>
          ))}
        </section>

        <section class="mb-8 space-y-5">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-6 rounded-full" style={{ backgroundColor: tenant.primaryColorDark }}></div>
            <h2 class="text-xl font-semibold text-surface-900">Who Should Buy the {product.name}</h2>
          </div>
          <div class="text-surface-700 leading-relaxed space-y-3 [&_p]:mb-3">
            <p>
              {isRugged
                ? `The ${product.name} is built for people who need storage that goes where they go. If you work outdoors, travel frequently, or simply want a drive that survives the daily commute without a protective case, this is one of the strongest options in the ${capacityLabel} portable SSD category.`
                : isHighSpeed
                  ? `The ${product.name} targets users who need maximum throughput from an external drive. If you edit 4K or 6K video, move large project files between workstations, or work directly from external storage, the ${product.read_speed_mbps.toLocaleString()} MB/s read speed puts this drive in elite territory for a ${capacityLabel} portable SSD.`
                  : isGaming
                    ? `The ${product.name} is designed for gamers who need fast, reliable external storage. Whether you are expanding a PS5 or Xbox library, building a portable PC game collection, or moving titles between machines, the ${capacityLabel} capacity holds ${Math.floor(product.capacity_gb / 50)}-${Math.floor(product.capacity_gb / 25)} game installs with ${product.read_speed_mbps.toLocaleString()} MB/s reads for quick load times.`
                    : `The ${product.name} is a solid all-around ${capacityLabel} portable SSD for everyday use. If you need fast backups, reliable file transport between devices, or external storage for documents, photos, and media, the ${product.read_speed_mbps.toLocaleString()} MB/s reads deliver performance that makes daily tasks feel instant compared to an external hard drive.`
              }
            </p>
            <p>
              {isHighCapacity
                ? `At ${capacityLabel}, this drive hits the sweet spot for users with substantial storage needs. Photo and video libraries, game collections, and professional project files all benefit from the headroom — you will not be juggling free space or swapping files between drives.`
                : product.capacity_gb >= 1000
                  ? `The ${capacityLabel} capacity covers most daily workflows comfortably: system backups, a working photo library, a dozen game installs, or a collection of documents and media. If you need more space, higher-capacity variants of the same product line are worth considering.`
                  : `At ${capacityLabel}, this drive works best as a secondary transport drive or backup destination rather than a primary storage solution. It holds a focused working set of files — a project folder, a photo shoot, or a selection of games — without the bulk of higher-capacity alternatives.`
              }
            </p>
            <p>
              {isUSB4 || isGen2x2
                ? `One important note: reaching the full ${product.read_speed_mbps.toLocaleString()} MB/s requires a ${isUSB4 ? "Thunderbolt 4 or USB4" : "USB 3.2 Gen 2x2 (20 Gbps)"} host port. On a standard USB 3.2 Gen 2 port, the drive still works perfectly but negotiates down to 10 Gbps. Most laptops from 2022 onward include a compatible port on premium models, but verify your hardware before expecting peak performance.`
                : product.interface === "USB 3.2 Gen 2"
                  ? `The USB 3.2 Gen 2 interface means the ${product.name} hits full speed on virtually any modern USB-C or USB-A port — no special hardware required. Plug it into a laptop, desktop, game console, or tablet and you get the same ${product.read_speed_mbps.toLocaleString()} MB/s performance without compatibility concerns.`
                  : `The ${product.interface} interface provides reliable connectivity across a wide range of devices. No driver installation is needed on Windows, macOS, or Linux — the drive is recognized and ready to use immediately.`
              }
            </p>
          </div>
        </section>

        <section class="mb-8 space-y-5">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-1 h-6 rounded-full" style={{ backgroundColor: tenant.primaryColorDark }}></div>
            <h2 class="text-xl font-semibold text-surface-900">Real-World Performance</h2>
          </div>
          <div class="text-surface-700 leading-relaxed space-y-3 [&_p]:mb-3">
            <div>
              <h3 class="text-base font-semibold text-surface-800 mb-1.5">File Transfer Speeds</h3>
              <p>
                On paper, the {product.name} delivers {product.read_speed_mbps.toLocaleString()} MB/s reads and {product.write_speed_mbps.toLocaleString()} MB/s writes. In practice, a 50GB file — a typical 4K video project, a large game install, or a full photo shoot — transfers in {transfer50gb}. A 100GB batch of raw files moves in {transfer100gb}. For users who regularly shuttle large files, these transfer times are a meaningful productivity improvement over slower SATA-based externals that take 3-5x longer for the same tasks.
              </p>
            </div>
            {isHighSpeed && (
              <div>
                <h3 class="text-base font-semibold text-surface-800 mb-1.5">Sustained Write Performance</h3>
                <p>
                  {isUSB4
                    ? `At ${product.read_speed_mbps.toLocaleString()} MB/s, the controller generates significant heat during extended writes. Sustained sequential transfers of 200GB or more can push controller temperatures past 70°C, triggering thermal throttling that reduces throughput by 20-35%. The aluminum enclosure helps dissipate heat, but for sustained workloads, expect speeds to settle below the rated peak after several minutes of continuous writing.`
                    : isGen2x2
                      ? `The ${product.read_speed_mbps.toLocaleString()} MB/s peak is achievable for burst transfers, but sustained writes of 100GB or more will see speeds settle to approximately ${Math.round(product.write_speed_mbps * 0.85).toLocaleString()}-${Math.round(product.write_speed_mbps * 0.90).toLocaleString()} MB/s as the controller manages thermals. This is normal for compact NVMe enclosures and does not affect everyday use — only continuous large-file writes are impacted.`
                      : `At ${product.read_speed_mbps.toLocaleString()} MB/s, thermal throttling is minimal during typical use. Only sustained sequential writes exceeding 100GB — such as backing up an entire media library in one pass — may cause the controller to reduce speeds temporarily. For everyday transfers and backups, you will consistently see performance near the rated specifications.`
                  }
                </p>
              </div>
            )}
            <div>
              <h3 class="text-base font-semibold text-surface-800 mb-1.5">What "Speed" Actually Means for Daily Use</h3>
              <p>
                Sequential read and write speeds — the numbers manufacturers advertise — matter most when transferring single large files. For everyday tasks like opening documents, browsing photos, running applications from the drive, or loading games, random 4K performance is more relevant. All NVMe-based external SSDs deliver random IOPS in the same general range, so the ${product.name} feels similarly responsive to other fast portables for daily use. The real differentiator shows up during large file transfers, where the ${product.read_speed_mbps.toLocaleString()} MB/s read speed pulls noticeably ahead of slower SATA-based externals.
              </p>
            </div>
            <div>
              <h3 class="text-base font-semibold text-surface-800 mb-1.5">Endurance and Longevity</h3>
              <p>
                The ${product.name} is rated for ${product.tbw.toLocaleString()} TBW (terabytes written) endurance. To put that in perspective: if you write 50GB per day — an aggressive daily workload for most users — the drive would take approximately ${Math.round(product.tbw * 1000 / 50 / 365)} years to reach its endurance limit. For typical use patterns involving backups, file transfers, and game storage, the ${product.tbw.toLocaleString()} TBW rating provides comfortable headroom well beyond the ${product.warranty_years}-year warranty period.
              </p>
            </div>
          </div>
        </section>

        {topCompetitor && (
          <section class="mb-8">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-1 h-6 rounded-full" style={{ backgroundColor: tenant.primaryColorDark }}></div>
              <h2 class="text-xl font-semibold text-surface-900">{product.name} vs {topCompetitor.name}</h2>
            </div>
            <div class="rounded-xl border border-surface-300 overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-surface-300 bg-surface-50/50">
                      <th class="text-left py-3 px-4 font-medium text-surface-700">Spec</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">{product.name}</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">{topCompetitor.name}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-surface-200">
                      <td class="py-2.5 px-4 font-medium text-surface-700 bg-surface-50/50">Read Speed</td>
                      <td class="text-center py-2.5 px-4 font-mono font-medium text-surface-900">{product.read_speed_mbps.toLocaleString()} MB/s</td>
                      <td class="text-center py-2.5 px-4 font-mono font-medium text-surface-900">{topCompetitor.read_speed_mbps.toLocaleString()} MB/s</td>
                    </tr>
                    <tr class="border-b border-surface-200 bg-surface-50/30">
                      <td class="py-2.5 px-4 font-medium text-surface-700 bg-surface-50/50">Write Speed</td>
                      <td class="text-center py-2.5 px-4 font-mono font-medium text-surface-900">{product.write_speed_mbps.toLocaleString()} MB/s</td>
                      <td class="text-center py-2.5 px-4 font-mono font-medium text-surface-900">{topCompetitor.write_speed_mbps.toLocaleString()} MB/s</td>
                    </tr>
                    <tr class="border-b border-surface-200">
                      <td class="py-2.5 px-4 font-medium text-surface-700 bg-surface-50/50">Capacity</td>
                      <td class="text-center py-2.5 px-4 font-medium text-surface-900">{capacityLabel}</td>
                      <td class="text-center py-2.5 px-4 font-medium text-surface-900">{topCompetitor.capacity_gb >= 1000 ? `${(topCompetitor.capacity_gb / 1000).toFixed(0)}TB` : `${topCompetitor.capacity_gb}GB`}</td>
                    </tr>
                    <tr class="border-b border-surface-200 bg-surface-50/30">
                      <td class="py-2.5 px-4 font-medium text-surface-700 bg-surface-50/50">Interface</td>
                      <td class="text-center py-2.5 px-4 text-surface-900">{product.interface}</td>
                      <td class="text-center py-2.5 px-4 text-surface-900">{topCompetitor.interface}</td>
                    </tr>
                    <tr class="border-b border-surface-200">
                      <td class="py-2.5 px-4 font-medium text-surface-700 bg-surface-50/50">Endurance</td>
                      <td class="text-center py-2.5 px-4 text-surface-900">{product.tbw.toLocaleString()} TBW</td>
                      <td class="text-center py-2.5 px-4 text-surface-900">{topCompetitor.tbw.toLocaleString()} TBW</td>
                    </tr>
                    <tr>
                      <td class="py-2.5 px-4 font-medium text-surface-700 bg-surface-50/50">Score</td>
                      <td class="text-center py-2.5 px-4 font-bold text-surface-900">{product.overall_score.toFixed(1)}/10</td>
                      <td class="text-center py-2.5 px-4 font-bold text-surface-900">{topCompetitor.overall_score.toFixed(1)}/10</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="mt-4 text-surface-700 leading-relaxed space-y-2">
              <p>
                {product.overall_score > topCompetitor.overall_score
                  ? `The ${product.name} edges out the ${topCompetitor.name} in our scoring with a ${product.overall_score.toFixed(1)} vs ${topCompetitor.overall_score.toFixed(1)} rating. ${product.read_speed_mbps > topCompetitor.read_speed_mbps ? `It also delivers faster read speeds (${product.read_speed_mbps.toLocaleString()} vs ${topCompetitor.read_speed_mbps.toLocaleString()} MB/s), which matters most for file transfers and loading times.` : product.write_speed_mbps > topCompetitor.write_speed_mbps ? `It has a write speed advantage (${product.write_speed_mbps.toLocaleString()} vs ${topCompetitor.write_speed_mbps.toLocaleString()} MB/s) that benefits users who frequently save or transfer large files.` : `Both drives deliver comparable sequential performance, so the decision comes down to secondary factors like build quality, brand preference, and endurance rating.`}`
                  : product.overall_score === topCompetitor.overall_score
                    ? `Both drives score ${product.overall_score.toFixed(1)}/10 in our evaluation. ${product.read_speed_mbps > topCompetitor.read_speed_mbps ? `The ${product.name} has a read speed edge (${product.read_speed_mbps.toLocaleString()} vs ${topCompetitor.read_speed_mbps.toLocaleString()} MB/s).` : topCompetitor.read_speed_mbps > product.read_speed_mbps ? `The ${topCompetitor.name} has faster reads (${topCompetitor.read_speed_mbps.toLocaleString()} vs ${product.read_speed_mbps.toLocaleString()} MB/s).` : `Sequential performance is similar — compare other factors like endurance, warranty, and build quality.`} Check both models on the retailer's site for the latest details.`
                    : `The ${topCompetitor.name} scores higher in our evaluation (${topCompetitor.overall_score.toFixed(1)} vs ${product.overall_score.toFixed(1)}/10). ${topCompetitor.read_speed_mbps > product.read_speed_mbps ? `It also delivers faster reads (${topCompetitor.read_speed_mbps.toLocaleString()} vs ${product.read_speed_mbps.toLocaleString()} MB/s).` : `While the ${product.name} has lower scoring, it may offer advantages in other areas like ${product.tbw > topCompetitor.tbw ? "endurance" : product.warranty_years > topCompetitor.warranty_years ? "warranty coverage" : "value"}. Review the full specifications above before deciding.`}`
                }
              </p>
              <p>
                For a detailed head-to-head comparison, see our full <a href={`/compare/${product.slug}-vs-${topCompetitor.slug}`} class="text-blue-800 hover:text-blue-900 font-medium">{product.name} vs {topCompetitor.name} comparison</a>.
              </p>
            </div>
          </section>
        )}

        {relatedProducts.length > 0 && (
          <section class="mb-8">
            <h2 class="text-xl font-semibold text-surface-900 mb-4">How {product.name} {capacityLabel} Compares</h2>
            <div class="rounded-xl border border-surface-300 overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-surface-300 bg-surface-50/50">
                      <th class="text-left py-3 px-4 font-medium text-surface-700">Model</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Capacity</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Interface</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Read</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Write</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">TBW</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-surface-200 bg-blue-50/40">
                      <td class="py-3 px-4 font-medium text-surface-900">
                        <a href={productUrl} class="text-blue-800 hover:text-blue-900">{product.name}</a>
                      </td>
                      <td class="text-center py-3 px-4 font-medium text-surface-900">{product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(0)}TB` : `${product.capacity_gb}GB`}</td>
                      <td class="text-center py-3 px-4 text-surface-700">{product.interface}</td>
                      <td class="text-center py-3 px-4 font-mono font-medium text-surface-900">{product.read_speed_mbps.toLocaleString()}</td>
                      <td class="text-center py-3 px-4 font-mono font-medium text-surface-900">{product.write_speed_mbps.toLocaleString()}</td>
                      <td class="text-center py-3 px-4 text-surface-700">{product.tbw.toLocaleString()}</td>
                    </tr>
                    {relatedProducts.map((rp) => (
                      <tr class="border-b border-surface-200 last:border-0 hover:bg-surface-50/50 transition-colors">
                        <td class="py-3 px-4">
                          <a href={`/products/${rp.slug}`} class="text-blue-800 hover:text-blue-900 font-medium">{rp.name}</a>
                        </td>
                        <td class="text-center py-3 px-4 text-surface-700">{rp.capacity_gb >= 1000 ? `${(rp.capacity_gb / 1000).toFixed(0)}TB` : `${rp.capacity_gb}GB`}</td>
                        <td class="text-center py-3 px-4 text-surface-700">{rp.interface}</td>
                        <td class="text-center py-3 px-4 font-mono text-surface-700">{rp.read_speed_mbps.toLocaleString()}</td>
                        <td class="text-center py-3 px-4 font-mono text-surface-700">{rp.write_speed_mbps.toLocaleString()}</td>
                        <td class="text-center py-3 px-4 text-surface-700">{rp.tbw.toLocaleString()}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
            <p class="text-xs text-surface-700 mt-2 italic">Specs shown for the closest {product.category_name} alternatives. Full comparison table available on the <a href={`/compare?category=${product.category_slug}`} class="text-blue-800 hover:text-blue-900 font-medium">compare page</a>.</p>
          </section>
        )}

        {brandProducts.length > 0 && (
          <section class="mb-8">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-surface-900">More {product.brand_name} SSDs</h2>
              <a
                href={`/compare?category=${product.category_slug}`}
                class="text-sm font-medium text-blue-800 hover:text-blue-900"
              >
                View all &rarr;
              </a>
            </div>
            <ProductGrid products={brandProducts} />
          </section>
        )}

        {productHubs.length > 0 && (
          <section class="mb-8">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-base font-semibold text-surface-900">Featured In</h2>
            </div>
            <div class="space-y-2">
              {productHubs.map((h) => (
                <a
                  href={`/hubs/${h.slug}`}
                  class="flex items-center gap-2 text-sm text-blue-800 hover:text-blue-900 no-underline group"
                >
                  <svg aria-hidden="true" class="w-4 h-4 shrink-0 text-surface-700 group-hover:text-blue-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                  <span>{h.name}</span>
                  <svg aria-hidden="true" class="w-3 h-3 ml-auto group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-8 space-y-4">
          {primaryLink && (
            <GeoAffiliateLink
              url={primaryLink.affiliate_url || ""}
              retailer={primaryLink.retailer}
              label={`Check on ${primaryLink.retailer} →`}
              urlSource={primaryLink.url_source}
              useCartExtend
              className="w-full justify-center py-3 text-sm font-semibold bg-blue-800 text-white border-blue-800 hover:bg-blue-900 [&_svg]:text-white"
            />
          )}

          {allPrices.length > 1 && (
            <div class="rounded-xl border border-surface-300 p-5">
              <h3 class="text-sm font-semibold text-surface-700 mb-3">Prices at Other Retailers</h3>
              <div class="space-y-2">
                {allPrices.map((price) => (
                  <a
                    href={`/products/${product.slug}/${price.retailer === "B&H Photo" ? "bh-photo" : price.retailer.toLowerCase()}`}
                    class="flex items-center justify-between text-sm hover:bg-surface-50 p-2 rounded-lg transition-colors"
                  >
                    <span class="text-surface-700">{price.retailer}{price.condition === "used" ? " (used)" : ""}</span>
                    <span class="font-medium text-surface-900">Check Price →</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Quick Specs</h3>
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs text-surface-700 mb-1">
                  <span>Read Speed</span>
                  <span class="font-mono font-medium text-surface-700">{product.read_speed_mbps} MB/s</span>
                </div>
                <div class="spec-bar">
                  <div class="spec-bar-fill bg-blue-700" style={{ width: `${Math.min(100, (product.read_speed_mbps / 3000) * 100)}%` }}></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-xs text-surface-700 mb-1">
                  <span>Write Speed</span>
                  <span class="font-mono font-medium text-surface-700">{product.write_speed_mbps} MB/s</span>
                </div>
                <div class="spec-bar">
                  <div class="spec-bar-fill bg-emerald-700" style={{ width: `${Math.min(100, (product.write_speed_mbps / 3000) * 100)}%` }}></div>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Browse by Category</h3>
            <div class="space-y-2">
              {product.category_slug && (
                <a
                  href={`/category/${product.category_slug}`}
                  class="block px-3 py-2 text-sm rounded-lg text-surface-700 hover:bg-surface-50 transition-colors"
                >
                  {product.category_name}
                </a>
              )}
              {product.category_slug && (
                <a
                  href={`/best/${product.category_slug}`}
                  class="block px-3 py-2 text-sm rounded-lg text-surface-700 hover:bg-surface-50 transition-colors"
                >
                  Best {product.category_name?.replace(/\s+SSDs?$/i, "")} SSDs
                </a>
              )}
            </div>
          </div>

          {product.brand_slug && (
            <div class="rounded-xl border border-surface-300 p-5">
              <h3 class="text-sm font-semibold text-surface-700 mb-3">More from {product.brand_name}</h3>
              <a
                href={`/brands/${product.brand_slug}`}
                class="block px-3 py-2 text-sm rounded-lg text-surface-700 hover:bg-surface-50 transition-colors"
              >
                All {product.brand_name} SSDs
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
