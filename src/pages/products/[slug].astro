---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import GeoAffiliateLink from "@components/GeoAffiliateLink.astro";
import PriceStamp from "@components/PriceStamp.astro";
import ProductGrid from "@components/ProductGrid.astro";
import { getProductBySlug, getProductPricesFresh, getProductsByBrand, getRelatedProducts, getHubsForProduct } from "@lib/db";
import type { Hub } from "@lib/db";
import { classifyDrive } from "@lib/editorial";
import { getLowestPrice } from "@lib/pricing";

const { DB, tenant, hostname, marketplace } = Astro.locals;
const { slug } = Astro.params;
const db = DB!;

const product = await getProductBySlug(db, tenant.id, slug!);
if (!product) {
  return Astro.redirect("/404");
}

// Freshness-filtered, marketplace-matched, in-stock-only prices.
// Pol IP §2(b): prices only displayed if reasonably current + accurate.
// Pol IP §2(c)(h) line 541: 24h cache clock enforced.
const livePrices = await getProductPricesFresh(db, product.id, { marketplace, inStockOnly: true });
const bestPrice = getLowestPrice(livePrices as any);
// Lowest Amazon new + used for comparison-pricing block (Pol §2(b) line 331).
const amazonNew = livePrices.find((p) => p.retailer === "Amazon" && (p.condition || "new") === "new");
const amazonUsed = livePrices.find((p) => p.retailer === "Amazon" && p.condition === "used");
const otherRetailers = livePrices.filter(
  (p) => p.retailer !== "Amazon" || (p.condition && p.condition !== "new")
).filter((p) => p !== amazonUsed);

// Stale-but-known price — used ONLY for the affiliate link target (no
// price text shown). Pol §2(b) restricts price *display* accuracy;
// affiliate links themselves may still be rendered. The visitor lands
// on Amazon's own page where Amazon displays the current price.
const stalePrices = !bestPrice
  ? await getProductPricesFresh(db, product.id, { marketplace, inStockOnly: true, maxAgeHours: 24 * 365 })
  : [];
const fallbackLinkPrice = stalePrices.find((p) => p.retailer === "Amazon" && (p.condition || "new") === "new")
  || stalePrices[0]
  || null;

const brandProducts = product.brand_id
  ? await getProductsByBrand(db, tenant.id, product.brand_id, product.id)
  : [];
const relatedProducts = product.category_id
  ? (await getRelatedProducts(db, tenant.id, product.category_id, product.id)).slice(0, 3)
  : [];
const productHubs: Hub[] = await getHubsForProduct(db, tenant.id, product, 4);

const scoreColor =
  product.overall_score >= 9
    ? "text-emerald-800 bg-emerald-50"
    : product.overall_score >= 8
    ? "text-blue-800 bg-blue-50"
    : "text-amber-900 bg-amber-50";

const scoreBgColor =
  product.overall_score >= 9
    ? "bg-emerald-50"
    : product.overall_score >= 8
    ? "bg-blue-50"
    : "bg-amber-50";

const productUrl = `https://${hostname}/products/${product.slug}`;
const siteUrl = `https://${hostname}`;

const capacityLabel = product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(product.capacity_gb % 1000 === 0 ? 0 : 1)}TB` : `${product.capacity_gb}GB`;
const currentYear = new Date().getFullYear();
const bandwidthLabel = product.read_speed_mbps >= 1000 ? `${(product.read_speed_mbps / 1000).toFixed(1)} GB/s` : `${product.read_speed_mbps} MB/s`;

const pros: string[] = product.pros ? JSON.parse(product.pros) : [];
const cons: string[] = product.cons ? JSON.parse(product.cons) : [];

const productJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "@id": productUrl,
  name: `${product.name} ${capacityLabel} Portable SSD`,
  description: product.description,
  mpn: product.model || product.slug,
  ...(product.gtin13 ? { gtin13: product.gtin13 } : {}),
  brand: {
    "@type": "Brand",
    name: product.brand_name,
  },
  image: `${siteUrl}/favicon-external.svg`,
  category: product.category_name,
  // Editorial authored review (not aggregate); Pol §5(t) line 393 prohibits
  // displaying customer reviews/star ratings unless sourced via PA API or
  // Creators API. Our overall_score is editorial, exposed as a single Review.
  "review": {
    "@type": "Review",
    author: { "@type": "Organization", name: tenant.name },
    reviewRating: {
      "@type": "Rating",
      ratingValue: Math.round(product.overall_score / 2 * 10) / 10,
      bestRating: 5,
      worstRating: 1,
    },
  },
  ...(bestPrice
    ? {
        offers: {
          "@type": "Offer",
          availability: "https://schema.org/InStock",
          // Pol §5(v) line 405 — do not cloak the destination URL. Schema.org
          // Offer.url should point to the page on YOUR site containing the
          // offer (which has the actual affiliate link), not the affiliate URL.
          url: productUrl,
          priceCurrency: bestPrice.currency,
          seller: { "@type": "Organization", name: bestPrice.retailer },
        },
      }
    : {
        offers: {
          "@type": "Offer",
          availability: "https://schema.org/OutOfStock",
          url: productUrl,
        },
      }),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    ...(product.category_name
      ? [{ "@type": "ListItem", position: 2, name: product.category_name, item: `${siteUrl}/compare?category=${product.category_slug}` }]
      : []),
    { "@type": "ListItem", position: product.category_name ? 3 : 2, name: product.name, item: productUrl },
  ],
};

const faqEntries = [
  {
    q: `What are the read and write speeds of the ${product.name}?`,
    a: `The ${product.name} ${capacityLabel} delivers sequential read speeds of ${product.read_speed_mbps.toLocaleString()} MB/s and write speeds of ${product.write_speed_mbps.toLocaleString()} MB/s over its ${product.interface} interface.`,
  },
  {
    q: `What interface does the ${product.name} use?`,
    a: `The ${product.name} uses a ${product.interface} interface with a theoretical maximum bandwidth of ${bandwidthLabel}.`,
  },
  {
    q: `How much storage does the ${product.name} ${capacityLabel} hold?`,
    a: `The ${product.name} provides ${capacityLabel} of usable storage, enough for approximately ${Math.floor(product.capacity_gb / 50)} hours of 4K video or ${Math.floor(product.capacity_gb / 4)} large game installs.`,
  },
  {
    q: `What is the endurance rating of the ${product.name}?`,
    a: `The ${product.name} is rated for ${product.tbw.toLocaleString()} TBW (terabytes written) endurance, backed by a ${product.warranty_years}-year limited warranty from ${product.brand_name}.`,
  },
  {
    q: `Is the ${product.name} compatible with PlayStation 5 and Xbox?`,
    a: `Yes, the ${product.name} works with PlayStation 5, Xbox Series X|S, and other consoles that support external USB storage. It can store and play games directly from the drive.`,
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqEntries.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const archetype = classifyDrive(product);
const calloutBg: Record<string, string> = {
  "elite-pro-creator": "bg-purple-50 border-purple-200",
  "console-gaming": "bg-indigo-50 border-indigo-200",
  "rugged-portable": "bg-amber-50 border-amber-200",
  "highspeed-usb-pro": "bg-sky-50 border-sky-200",
  "budget-everyday": "bg-surface-50 border-surface-200",
};
const calloutText: Record<string, string> = {
  "elite-pro-creator": "text-purple-800",
  "console-gaming": "text-indigo-800",
  "rugged-portable": "text-amber-900",
  "highspeed-usb-pro": "text-sky-800",
  "budget-everyday": "text-surface-800",
};
---

<BaseLayout
  title={`${product.name} ${capacityLabel} Review (${currentYear}): Price, Specs & Deals`}
  description={bestPrice
    ? `${product.name} ${capacityLabel} portable SSD: ${product.read_speed_mbps.toLocaleString()} MB/s reads, ${product.write_speed_mbps.toLocaleString()} MB/s writes. See current in-stock price at ${bestPrice.retailer}.`
    : `${product.name} ${capacityLabel} portable SSD: ${product.read_speed_mbps.toLocaleString()} MB/s reads, ${product.write_speed_mbps.toLocaleString()} MB/s writes, ${product.warranty_years}-year warranty. Full specs and review.`}
  jsonLd={[productJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <p class="text-xs text-surface-700 italic leading-relaxed">
        As an Amazon Associate I earn from qualifying purchases. We may earn a commission from qualifying purchases made through links on this page. Prices and availability are subject to change. We are reader-supported and independent — our rankings are based on an objective scoring rubric, not sponsorship.
      </p>
    </div>
    <div class="grid lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <Breadcrumb
          items={[
            { label: "Home", href: "/" },
            ...(product.category_slug
              ? [{ label: product.category_name, href: `/compare?category=${product.category_slug}` }]
              : []),
            { label: product.name },
          ]}
        />

        <div class="flex items-start justify-between mb-6">
          <div>
            <p class="text-sm font-medium text-surface-700 uppercase tracking-wider">{product.brand_name}</p>
            <h1 class="text-2xl sm:text-3xl font-bold text-surface-900 mt-0.5">{product.name} {capacityLabel}</h1>
            {product.model && (
              <p class="text-sm text-surface-700 mt-1">Model: {product.model}</p>
            )}
          </div>
          <div class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-bold ${scoreBgColor} ${scoreColor}`}>
            <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            {product.overall_score.toFixed(1)}/10
          </div>
        </div>

        <div class="rounded-xl border border-surface-300 overflow-hidden mb-8">
          <table class="compare-grid">
            <tbody>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50 w-40">Capacity</td>
                <td class="text-surface-900 font-medium">{product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(0)}TB` : `${product.capacity_gb}GB`}</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Interface</td>
                <td class="text-surface-900">{product.interface}</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Form Factor</td>
                <td class="text-surface-900">{product.form_factor}</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Read Speed</td>
                <td class="text-surface-900 font-mono font-medium">{product.read_speed_mbps.toLocaleString()} MB/s</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Write Speed</td>
                <td class="text-surface-900 font-mono font-medium">{product.write_speed_mbps.toLocaleString()} MB/s</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Endurance (TBW)</td>
                <td class="text-surface-900">{product.tbw.toLocaleString()} TB</td>
              </tr>
              <tr>
                <td class="font-medium text-surface-700 bg-surface-50/50">Warranty</td>
                <td class="text-surface-900">{product.warranty_years} Years</td>
              </tr>
            </tbody>
          </table>
        </div>

        {product.description && (
          <section class="mb-6">
            <h2 class="text-xl font-semibold text-surface-900 mb-3">Overview</h2>
            <p class="text-surface-700 leading-relaxed">{product.description}</p>
            <p class="text-sm text-surface-700 mt-2">
              See how it stacks up against competitors in our <a href={`/compare?category=${product.category_slug}`} class="text-blue-800 hover:text-blue-900 font-medium">{product.category_name} SSD comparison</a>, or browse related <a href="/hubs" class="text-blue-800 hover:text-blue-900 font-medium">SSD buying guides</a>.
            </p>
          </section>
        )}

        {bestPrice ? (
          <section class="mb-8 rounded-xl border border-surface-300 p-5">
            <h2 class="text-xl font-semibold text-surface-900 mb-3">Price & Where to Buy</h2>
            <div class="flex items-baseline gap-3 mb-4">
              <span class="text-lg font-semibold text-blue-800">See Price</span>
              <span class="text-sm text-surface-700">at {bestPrice.retailer}</span>
            </div>
            <GeoAffiliateLink
              url={bestPrice.affiliate_url || ""}
              retailer={bestPrice.retailer}
              label={`Check Price on ${bestPrice.retailer} →`}
              urlSource={bestPrice.url_source}
              useCartExtend
              className="mb-4 text-sm"
            />
            {(amazonUsed || otherRetailers.length > 0) && (
              <div class="mt-4 pt-4 border-t border-surface-200">
                <p class="text-xs font-semibold text-surface-700 uppercase tracking-wider mb-2">All retailers</p>
                <div class="space-y-1.5">
                  {amazonUsed && (
                    <GeoAffiliateLink
                      url={amazonUsed.affiliate_url || ""}
                      retailer={amazonUsed.retailer}
                      label={`Amazon (used) →`}
                      urlSource={amazonUsed.url_source}
                      className="text-sm"
                    />
                  )}
                  {otherRetailers.map((price) => (
                    <GeoAffiliateLink
                      url={price.affiliate_url || ""}
                      retailer={price.retailer}
                      label={`${price.retailer}${price.condition === "used" ? " (used)" : ""} →`}
                      urlSource={price.url_source}
                      className="text-sm"
                    />
                  ))}
                </div>
              </div>
            )}
            <PriceStamp fetchedAt={bestPrice.fetched_at} className="mt-4" />
          </section>
        ) : (
          <section class="mb-8 rounded-xl border border-surface-300 p-5">
            <h2 class="text-xl font-semibold text-surface-900 mb-3">Where to Buy</h2>
            <p class="text-sm text-surface-700 mb-3">
              We could not retrieve a current in-stock price within the last 24 hours, so no price is
              displayed here. Click through to {fallbackLinkPrice ? fallbackLinkPrice.retailer : "the retailer"}
              to see today's price on their site.
            </p>
            {fallbackLinkPrice?.affiliate_url && (
              <GeoAffiliateLink
                url={fallbackLinkPrice.affiliate_url}
                retailer={fallbackLinkPrice.retailer}
                label={`Check Price on ${fallbackLinkPrice.retailer} →`}
                urlSource={fallbackLinkPrice.url_source}
                useCartExtend
                className="text-sm"
              />
            )}
            <p class="text-xs text-surface-700 mt-4 italic">
              We earn a commission from qualifying purchases made through these links.
            </p>
          </section>
        )}

        <div class="grid sm:grid-cols-2 gap-6 mb-8">
          {pros.length > 0 && (
            <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-4">
              <h3 class="text-sm font-semibold text-emerald-800 mb-2">Pros</h3>
              <ul class="space-y-1">
                {pros.map((pro: string) => (
                  <li class="flex items-start gap-2 text-sm text-emerald-800">
                    <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {pro}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {cons.length > 0 && (
            <div class="rounded-xl border border-red-200 bg-red-50/50 p-4">
              <h3 class="text-sm font-semibold text-red-800 mb-2">Cons</h3>
              <ul class="space-y-1">
                {cons.map((con: string) => (
                  <li class="flex items-start gap-2 text-sm text-red-800">
                    <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-red-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    {con}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <section class="mb-8 space-y-5">
          <div>
            <h2 class="text-xl font-semibold text-surface-900 mb-1">{archetype.label} Analysis</h2>
            <p class="text-surface-700 leading-relaxed">{archetype.tagline}</p>
          </div>

          {archetype.blocks.map((block) => (
            <>
              {block.type === "prose" && (
                <div>
                  {block.title && (
                    <h3 class="text-base font-semibold text-surface-800 mb-1.5">{block.title}</h3>
                  )}
                  <p class="text-surface-700 leading-relaxed">{block.content}</p>
                </div>
              )}
              {block.type === "bullets" && (
                <div>
                  {block.title && (
                    <h3 class="text-base font-semibold text-surface-800 mb-1.5">{block.title}</h3>
                  )}
                  <ul class="space-y-1">
                    {block.items.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-surface-700">
                        <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-surface-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {block.type === "callout" && (
                <div class={`rounded-lg border ${calloutBg[archetype.id]} px-4 py-3`}>
                  <p class={`text-sm ${calloutText[archetype.id]}`}>{block.content}</p>
                </div>
              )}
            </>
          ))}
        </section>

        {relatedProducts.length > 0 && (
          <section class="mb-8">
            <h2 class="text-xl font-semibold text-surface-900 mb-4">How {product.name} {capacityLabel} Compares</h2>
            <div class="rounded-xl border border-surface-300 overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-surface-300 bg-surface-50/50">
                      <th class="text-left py-3 px-4 font-medium text-surface-700">Model</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Capacity</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Interface</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Read</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">Write</th>
                      <th class="text-center py-3 px-4 font-medium text-surface-700">TBW</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-surface-200 bg-blue-50/40">
                      <td class="py-3 px-4 font-medium text-surface-900">
                        <a href={productUrl} class="text-blue-800 hover:text-blue-900">{product.name}</a>
                      </td>
                      <td class="text-center py-3 px-4 font-medium text-surface-900">{product.capacity_gb >= 1000 ? `${(product.capacity_gb / 1000).toFixed(0)}TB` : `${product.capacity_gb}GB`}</td>
                      <td class="text-center py-3 px-4 text-surface-700">{product.interface}</td>
                      <td class="text-center py-3 px-4 font-mono font-medium text-surface-900">{product.read_speed_mbps.toLocaleString()}</td>
                      <td class="text-center py-3 px-4 font-mono font-medium text-surface-900">{product.write_speed_mbps.toLocaleString()}</td>
                      <td class="text-center py-3 px-4 text-surface-700">{product.tbw.toLocaleString()}</td>
                    </tr>
                    {relatedProducts.map((rp) => (
                      <tr class="border-b border-surface-200 last:border-0 hover:bg-surface-50/50 transition-colors">
                        <td class="py-3 px-4">
                          <a href={`/products/${rp.slug}`} class="text-blue-800 hover:text-blue-900 font-medium">{rp.name}</a>
                        </td>
                        <td class="text-center py-3 px-4 text-surface-700">{rp.capacity_gb >= 1000 ? `${(rp.capacity_gb / 1000).toFixed(0)}TB` : `${rp.capacity_gb}GB`}</td>
                        <td class="text-center py-3 px-4 text-surface-700">{rp.interface}</td>
                        <td class="text-center py-3 px-4 font-mono text-surface-700">{rp.read_speed_mbps.toLocaleString()}</td>
                        <td class="text-center py-3 px-4 font-mono text-surface-700">{rp.write_speed_mbps.toLocaleString()}</td>
                        <td class="text-center py-3 px-4 text-surface-700">{rp.tbw.toLocaleString()}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
            <p class="text-xs text-surface-700 mt-2 italic">Specs shown for the closest {product.category_name} alternatives. Full comparison table available on the <a href={`/compare?category=${product.category_slug}`} class="text-blue-800 hover:text-blue-900 font-medium">compare page</a>.</p>
          </section>
        )}

        {brandProducts.length > 0 && (
          <section class="mb-8">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-semibold text-surface-900">More {product.brand_name} SSDs</h2>
              <a
                href={`/compare?category=${product.category_slug}`}
                class="text-sm font-medium text-blue-800 hover:text-blue-900"
              >
                View all &rarr;
              </a>
            </div>
            <ProductGrid products={brandProducts} />
          </section>
        )}

        {productHubs.length > 0 && (
          <section class="mb-8">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-base font-semibold text-surface-900">Featured In</h2>
            </div>
            <div class="space-y-2">
              {productHubs.map((h) => (
                <a
                  href={`/hubs/${h.slug}`}
                  class="flex items-center gap-2 text-sm text-blue-800 hover:text-blue-900 no-underline group"
                >
                  <svg aria-hidden="true" class="w-4 h-4 shrink-0 text-surface-700 group-hover:text-blue-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                  <span>{h.name}</span>
                  <svg aria-hidden="true" class="w-3 h-3 ml-auto group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-8 space-y-4">
          {(bestPrice || fallbackLinkPrice) ? (
            <>
              <GeoAffiliateLink
                url={(bestPrice || fallbackLinkPrice)!.affiliate_url || ""}
                retailer={(bestPrice || fallbackLinkPrice)!.retailer}
                label={`See Price on ${(bestPrice || fallbackLinkPrice)!.retailer} →`}
                urlSource={(bestPrice || fallbackLinkPrice)!.url_source}
                useCartExtend
                className="w-full justify-center py-3 text-sm font-semibold bg-blue-800 text-white border-blue-800 hover:bg-blue-900 [&_svg]:text-white"
              />
              {bestPrice && <PriceStamp fetchedAt={bestPrice.fetched_at} className="mt-2" />}
              {!bestPrice && fallbackLinkPrice && (
                <p class="text-xs text-surface-500 italic mt-2">Pricing temporarily unavailable — click to view on {fallbackLinkPrice.retailer}</p>
              )}
            </>
          ) : null}

          {livePrices.length > 1 && (
            <div class="rounded-xl border border-surface-300 p-5">
              <h3 class="text-sm font-semibold text-surface-700 mb-3">Prices at Other Retailers</h3>
              <div class="space-y-2">
                {livePrices.map((price) => (
                  <a
                    href={`/products/${product.slug}/${price.retailer === "B&H Photo" ? "bh-photo" : price.retailer.toLowerCase()}`}
                    class="flex items-center justify-between text-sm hover:bg-surface-50 p-2 rounded-lg transition-colors"
                  >
                    <span class="text-surface-700">{price.retailer}{price.condition === "used" ? " (used)" : ""}</span>
                    <span class="font-medium text-surface-900">Check Price →</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Quick Specs</h3>
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-xs text-surface-700 mb-1">
                  <span>Read Speed</span>
                  <span class="font-mono font-medium text-surface-700">{product.read_speed_mbps} MB/s</span>
                </div>
                <div class="spec-bar">
                  <div class="spec-bar-fill bg-blue-700" style={{ width: `${Math.min(100, (product.read_speed_mbps / 3000) * 100)}%` }}></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-xs text-surface-700 mb-1">
                  <span>Write Speed</span>
                  <span class="font-mono font-medium text-surface-700">{product.write_speed_mbps} MB/s</span>
                </div>
                <div class="spec-bar">
                  <div class="spec-bar-fill bg-emerald-700" style={{ width: `${Math.min(100, (product.write_speed_mbps / 3000) * 100)}%` }}></div>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-surface-300 p-5">
            <h3 class="text-sm font-semibold text-surface-700 mb-3">Browse by Category</h3>
            <div class="space-y-2">
              {product.category_slug && (
                <a
                  href={`/category/${product.category_slug}`}
                  class="block px-3 py-2 text-sm rounded-lg text-surface-700 hover:bg-surface-50 transition-colors"
                >
                  {product.category_name}
                </a>
              )}
              {product.category_slug && (
                <a
                  href={`/best/${product.category_slug}`}
                  class="block px-3 py-2 text-sm rounded-lg text-surface-700 hover:bg-surface-50 transition-colors"
                >
                  Best {product.category_name?.replace(/\s+SSDs?$/i, "")} SSDs
                </a>
              )}
            </div>
          </div>

          {product.brand_slug && (
            <div class="rounded-xl border border-surface-300 p-5">
              <h3 class="text-sm font-semibold text-surface-700 mb-3">More from {product.brand_name}</h3>
              <a
                href={`/brands/${product.brand_slug}`}
                class="block px-3 py-2 text-sm rounded-lg text-surface-700 hover:bg-surface-50 transition-colors"
              >
                All {product.brand_name} SSDs
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
