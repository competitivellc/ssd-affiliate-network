---
import "../styles/globals.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import CookieConsent from "@components/CookieConsent.astro";
import { isEeaCountry } from "@lib/adsense";

export interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  canonical?: string;
}

const { tenant, hostname } = Astro.locals;
const { jsonLd, canonical: canonicalOverride } = Astro.props;
const canonicalPath = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const canonicalUrl = canonicalOverride || `https://${hostname}${canonicalPath}`;
const title = Astro.props.title
  ? `${Astro.props.title} | ${tenant.name}`
  : tenant.name;
const description = Astro.props.description || tenant.tagline;

const siteUrl = `https://${hostname}`;
const favicon = tenant.id === "portablessds" ? "/favicon-portable.svg" : "/favicon-external.svg";
const logoUrl = `${siteUrl}${favicon}`;

// AdSense is account-wide (one client ID can serve both tenants), so the
// SDK loader is wired whenever ANY tenant has a clientId configured and the
// visitor is outside the EEA/UK/CH certified-CMP scope (see adsense.ts).
// Individual ad units are rendered by AdSlot.astro per placement.
const adsClient = tenant.adsense?.clientId && !isEeaCountry(Astro.locals.countryCode || "")
  ? tenant.adsense.clientId
  : "";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: tenant.name,
  url: siteUrl,
  logo: logoUrl,
  description: tenant.tagline,
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: tenant.name,
  url: siteUrl,
  description: tenant.tagline,
};
---

<!DOCTYPE html>
<html lang="en" class="h-full" style={`--color-primary: ${tenant.primaryColor}; --color-primary-dark: ${tenant.primaryColorDark}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={tenant.id === "portablessds" ? "/favicon-portable.svg" : "/favicon-external.svg"} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {jsonLd && (Array.isArray(jsonLd) ? jsonLd.map(obj => <script type="application/ld+json" set:html={JSON.stringify(obj)} />) : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />)}
    {tenant.gaMeasurementId && (
      <script is:inline define:vars={{ gaId: tenant.gaMeasurementId }}>
        (function () {
          var GA_ID = gaId;
          var CONSENT_KEY = 'cookie-consent';

          function loadGA() {
            if (window.dataLayer) return;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            function gtag() { window.dataLayer.push(arguments); }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', GA_ID, { anonymize_ip: true });
            wireAffiliateClickTracking();
          }

          // GA4 outbound-click attribution for affiliate Special Links.
          // Passive capture-phase listener — never preventDefault, never
          // modify href/rel/target, never block navigation. Amazon-compliant
          // (first-party analytics on our own site; does not modify the
          // Special Link, the Associates tag, the cart-extend linkCode, or
          // the destination host). Skips silently when consent was not
          // granted (window.gtag undefined) — the Special Link still opens.
          function wireAffiliateClickTracking() {
            if (document.__affWire) return;
            document.__affWire = true;
            document.addEventListener('click', function (e) {
              if (typeof window.gtag !== 'function') return;
              var t = e.target;
              if (!t || !t.closest) return;
              var a = t.closest('a[data-affiliate="1"]');
              if (!a) return;
              window.gtag('event', 'affiliate_click', {
                link_url:      a.href,
                link_domain:  a.hostname,
                retailer:      a.dataset.retailer || '',
                cta_label:    a.dataset.cta || '',
                product_slug: a.dataset.productSlug || '',
                page_path:    location.pathname,
                page_location: location.href
              });
            }, true);
          }

          var consent = null;
          try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}
          if (consent === 'accepted') {
            loadGA();
          } else {
            var acceptBtn = document.getElementById('cookie-consent-accept');
            if (acceptBtn) {
              acceptBtn.addEventListener('click', function () {
                try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}
                if (consent === 'accepted') loadGA();
              });
            }
          }
        })();
      </script>
    )}
    {adsClient && (
      <script is:inline define:vars={{ adsClient }}>
        (function () {
          var CONSENT_KEY = 'cookie-consent';

          // Google AdSense SDK loader, gated on the same cookie-consent
          // signal as GA4. The adsbygoogle.js SDK is only fetched after the
          // visitor accepts cookies, so no ad cookies fire without consent.
          // AdSlot components push {}-entries into window.adsbygoogle —
          // entries queued before SDK load are drained by the loader on
          // load; entries pushed after load hit the SDK's push handler
          // (both behaviors are the documented adsbygoogle async pattern).
          function loadAdSense() {
            if (window.__adsenseLoaded) return;
            window.__adsenseLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + adsClient;
            document.head.appendChild(s);
          }

          var consent = null;
          try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}
          if (consent === 'accepted') {
            loadAdSense();
          } else {
            var acceptBtn = document.getElementById('cookie-consent-accept');
            if (acceptBtn) {
              acceptBtn.addEventListener('click', function () {
                try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}
                if (consent === 'accepted') loadAdSense();
              });
            }
          }
        })();
      </script>
    )}
  </head>
  <body class="h-full flex flex-col">
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-surface-900 focus:text-white focus:font-semibold focus:shadow-lg"
       id="skip-to-main">
      Skip to main content
    </a>
    <Header tenant={tenant} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer tenant={tenant} />
    <CookieConsent />
  </body>
</html>
