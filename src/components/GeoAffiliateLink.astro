---
import { buildAffiliateUrl } from "@lib/affiliate";
import type { UrlSource } from "@lib/db";

export interface Props {
  url: string;
  retailer: string;
  label: string;
  className?: string;
  /**
   * Source of the URL. PA-API URLs are passed through verbatim per
   * Amazon Pol §6(a) line 363 — never altered, never re-tagged.
   */
  urlSource?: UrlSource;
  /**
   * Opt-in for cart-extend linkCode=ll1 (Pol §1(c)(i) line 128).
   * Use on primary high-intent CTAs (product page buy button, ProductCard
   * "See Price" button). Leave undefined for secondary "other retailers" rows.
   */
  useCartExtend?: boolean;
  /**
   * Optional product slug for GA4 outbound-click attribution (added
   * 2026-08-07). Rendered as data-product-slug on the <a>. Empty/falsy
   * values are allowed and render as data-product-slug="". Purely passive
   * measurement — does NOT alter href, rel, target, or the affiliate tag.
   */
  productSlug?: string;
}

const { url, retailer, label, className = "", urlSource, useCartExtend, productSlug } = Astro.props;
const { DB, tenant, countryCode, marketplace } = Astro.locals;

let finalUrl: string | null = null;
if (url && url !== "#") {
  finalUrl = await buildAffiliateUrl(url, {
    db: DB as any,
    siteId: tenant.id,
    retailer,
    country: countryCode,
    marketplace,
    urlSource,
    useCartExtend,
  });
}

// Pol §2(b) "no misleading claims" + Plan D2: never render <a href="#">.
// If the URL failed rewrite (no tag, malformed, etc.), returning nothing
// is better than rendering a non-functional button.
if (!finalUrl) {
  return null;
}
---

<a
  href={finalUrl}
  target="_blank"
  rel="noopener sponsored"
  data-affiliate="1"
  data-retailer={retailer}
  data-cta={label}
  data-product-slug={productSlug || ""}
  class={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors ${className || "border-surface-500 text-surface-800 hover:border-surface-700 hover:bg-surface-50"}`}
>
  {label}
  <svg aria-hidden="true" class="w-3 h-3 text-surface-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
  </svg>
</a>
