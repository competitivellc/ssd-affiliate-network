---
import { isEeaCountry } from "@lib/adsense";

export interface Props {
  placement: "home" | "compare" | "product";
  className?: string;
}

const { placement, className = "" } = Astro.props;
const { tenant, countryCode } = Astro.locals;
const cfg = tenant.adsense;
const slotKey = placement === "home" ? "homeSlotId" : placement === "compare" ? "compareSlotId" : "productSlotId";
const clientId = cfg?.clientId || "";
const slotId = cfg?.[slotKey] || "";

// Render nothing unless the tenant has AdSense configured (client + a slot
// ID for this placement) AND the visitor is outside the EEA/UK/CH
// certified-CMP scope. The SDK is loaded by the publisher snippet in
// BaseLayout's <head>; this unit stays empty until the visitor accepts
// cookies (see the inline script below), so no ad cookies or ad requests
// fire without consent.
const enabled = !!(clientId && slotId && !isEeaCountry(countryCode || ""));
const adClient = enabled ? clientId : "";
const adSlot = enabled ? slotId : "";
---

{enabled && (
  <div class={`mt-2 mb-10 border-t border-surface-200 pt-4 ${className}`.trim()}>
    <ins
      class="adsbygoogle block w-full"
      style="display: block;"
      data-ad-client={adClient}
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (function () {
        // Consent-gated fill: only push a fill request after the visitor has
        // accepted cookies (same signal as GA4). Without consent the unit
        // stays zero-height and the SDK makes no ad request. The adsbygoogle
        // push queue drains on SDK load / runs via its push handler after
        // load — the documented async pattern.
        var CONSENT_KEY = 'cookie-consent';
        function push() {
          try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
        }
        var consent = null;
        try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}
        if (consent === 'accepted') {
          push();
        } else {
          var acceptBtn = document.getElementById('cookie-consent-accept');
          if (acceptBtn) {
            acceptBtn.addEventListener('click', function () {
              try { consent = localStorage.getItem(CONSENT_KEY); } catch (e) {}
              if (consent === 'accepted') push();
            });
          }
        }
      })();
    </script>
  </div>
)}