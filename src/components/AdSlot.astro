---
import { isEeaCountry } from "@lib/adsense";

export interface Props {
  placement: "home" | "compare" | "product";
  className?: string;
}

const { placement, className = "" } = Astro.props;
const { tenant, countryCode } = Astro.locals;
const cfg = tenant.adsense;
const slotKey = placement === "home" ? "homeSlotId" : placement === "compare" ? "compareSlotId" : "productSlotId";
const clientId = cfg?.clientId || "";
const slotId = cfg?.[slotKey] || "";

// Render nothing unless the tenant has AdSense configured (client + a slot
// ID for this placement) AND the visitor is outside the EEA/UK/CH
// certified-CMP scope. The SDK is loaded by the publisher snippet in
// BaseLayout's <head>. With Consent Mode v2 (always-on gtag with default-
// denied storage), the unit's fill request fires unconditionally — the SDK
// serves non-personalized contextually-targeted ads while consent is denied
// (NPA = still policy-compliant revenue, no ad cookies set) and upgrades to
// personalized fill once the visitor clicks Accept. The EEA geo-gate is
// independent: ad serving stays OFF there because Consent Mode v2 alone
// does not satisfy Google's CMP requirement for EEA traffic.
const enabled = !!(clientId && slotId && !isEeaCountry(countryCode || ""));
const adClient = enabled ? clientId : "";
const adSlot = enabled ? slotId : "";
---

{enabled && (
  <div class={`mt-2 mb-10 border-t border-surface-200 pt-4 ${className}`.trim()}>
    <ins
      class="adsbygoogle block w-full"
      style="display: block;"
      data-ad-client={adClient}
      data-ad-slot={adSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (function () {
        // Unconditional fill — Consent Mode v2 (BaseLayout.astro) governs
        // whether the SDK sets ad cookies. When consent is denied, Google
        // serves non-personalized contextually-targeted ads (no cookies set,
        // still revenue). When granted, fills become personalized.
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      })();
    </script>
  </div>
)}